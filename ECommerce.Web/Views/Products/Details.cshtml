@model ECommerce.Web.Models.ViewModels.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.Name;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex text-xs text-zinc-500 dark:text-zinc-400 mb-6 items-center">
        <a asp-controller="Home" asp-action="Index" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Trang chủ</a>
        <span class="mx-2 text-zinc-300 dark:text-zinc-700">/</span>
        <a asp-controller="Products" asp-action="Index" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Sản phẩm</a>
        @if (Model.Product.Category != null)
        {
            <span class="mx-2 text-zinc-300 dark:text-zinc-700">/</span>
            <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.Product.CategoryId" class="hover:text-zinc-950 dark:hover:text-white transition-colors">@Model.Product.Category.Name</a>
        }
        <span class="mx-2 text-zinc-300 dark:text-zinc-700">/</span>
        <span class="text-zinc-900 dark:text-zinc-100 font-medium truncate max-w-xs">@Model.Product.Name</span>
    </nav>

    <!-- Khung chính sản phẩm -->
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 bg-white dark:bg-zinc-900 p-6 sm:p-8 rounded-lg border border-zinc-200 dark:border-zinc-800">
        <!-- Ảnh sản phẩm -->
        <div class="w-full lg:w-1/2">
            <div class="bg-zinc-50 dark:bg-zinc-800/40 rounded-lg p-8 mb-3 aspect-square flex items-center justify-center border border-zinc-200/80 dark:border-zinc-800 overflow-hidden">
                <img src="@ProductImage.Resolve(Model.Product.ImageUrl)" alt="@Model.Product.Name" 
                     class="max-h-full max-w-full object-contain hover:scale-105 transition-transform duration-500 ease-out">
            </div>
            <!-- Thumbnails preview -->
            <div class="flex items-center gap-3">
                <div class="w-14 h-14 bg-zinc-50 dark:bg-zinc-800 rounded-md p-1.5 border-2 border-zinc-900 dark:border-zinc-100 flex items-center justify-center cursor-pointer">
                    <img src="@ProductImage.Resolve(Model.Product.ImageUrl)" alt="@Model.Product.Name" class="max-h-full max-w-full object-contain">
                </div>
            </div>
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="w-full lg:w-1/2 flex flex-col">
            <div class="mb-5">
                <div class="flex items-center gap-2 mb-3">
                    @if (Model.Product.StockQuantity > 0)
                    {
                        <span class="inline-flex items-center px-2.5 py-0.5 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 text-[11px] font-medium rounded border border-emerald-200 dark:border-emerald-800">
                            <i class="fas fa-check-circle mr-1 text-emerald-600 dark:text-emerald-400"></i> Còn hàng (@Model.Product.StockQuantity sản phẩm)
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-2.5 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-[11px] font-medium rounded border border-zinc-200 dark:border-zinc-700">
                            <i class="fas fa-times-circle mr-1 text-zinc-400"></i> Tạm hết hàng
                        </span>
                    }
                    <span class="text-xs text-zinc-400">Mã SP: #PRD-@Model.Product.Id.ToString("D4")</span>
                </div>

                <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-white mb-2 leading-tight">
                    @Model.Product.Name
                </h1>

                <div class="flex items-center gap-3 text-xs mb-4">
                    @if (Model.ReviewCount > 0)
                    {
                        <span class="flex items-center gap-0.5 text-amber-500" aria-label="Điểm đánh giá @Model.AverageRating.ToString("0.0") trên 5">
                            @for (var star = 1; star <= 5; star++)
                            {
                                <i class="fas fa-star @(star <= Math.Round(Model.AverageRating) ? "" : "text-zinc-300 dark:text-zinc-700") text-[11px]"></i>
                            }
                        </span>
                        <span class="text-zinc-700 dark:text-zinc-300 font-semibold">@Model.AverageRating.ToString("0.0")</span>
                        <span class="text-zinc-400">(@Model.ReviewCount nhận xét)</span>
                    }
                    else
                    {
                        <span class="text-zinc-400">Chưa có đánh giá</span>
                    }
                    <span class="text-zinc-300 dark:text-zinc-700">|</span>
                    <span class="text-zinc-600 dark:text-zinc-400">Danh mục: <strong>@Model.Product.Category?.Name</strong></span>
                </div>
            </div>

            <div class="mb-5 pb-5 border-b border-zinc-100 dark:border-zinc-800">
                <div class="flex items-baseline gap-3 mb-1">
                    <span class="text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">
                        <vc:money amount="@Model.Product.Price" />
                    </span>
                </div>
                <p class="text-zinc-400 text-xs">Giá niêm yết chính hãng, đã bao gồm thuế tiêu chuẩn</p>
            </div>

            <!-- Tóm tắt mô tả -->
            <div class="mb-6">
                <h3 class="font-medium text-zinc-900 dark:text-zinc-100 text-xs uppercase tracking-wider mb-2">Thông tin tóm tắt</h3>
                <p class="text-zinc-600 dark:text-zinc-400 text-xs leading-relaxed">
                    @(string.IsNullOrWhiteSpace(Model.Product.Description) ? "Sản phẩm chất lượng cao được tuyển chọn và kiểm định kỹ thuật bởi TechNova." : Model.Product.Description)
                </p>
            </div>

            @if (Model.Product.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-auto">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Product.Id" />

                    <div class="mb-5">
                        <label for="quantity-input" class="block font-medium text-zinc-700 dark:text-zinc-300 text-xs uppercase tracking-wider mb-2">Số lượng</label>
                        <div class="flex items-center">
                            <div class="flex items-center border border-zinc-200 dark:border-zinc-700 rounded-md bg-zinc-50 dark:bg-zinc-800/60 w-32">
                                <button type="button" onclick="decrementQty()" aria-label="Giảm số lượng"
                                        class="px-3 py-1.5 text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition active:scale-90 focus:outline-none">
                                    <i class="fas fa-minus text-[10px]"></i>
                                </button>
                                <input type="number" id="quantity-input" name="quantity" value="1" min="1" max="@Model.Product.StockQuantity" 
                                       class="w-full text-center font-semibold text-zinc-900 dark:text-zinc-100 bg-transparent focus:outline-none text-xs" />
                                <button type="button" onclick="incrementQty(@Model.Product.StockQuantity)" aria-label="Tăng số lượng"
                                        class="px-3 py-1.5 text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition active:scale-90 focus:outline-none">
                                    <i class="fas fa-plus text-[10px]"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button type="submit" 
                                class="flex-1 bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 hover:bg-zinc-800 dark:hover:bg-white font-medium py-3 px-6 rounded-md transition-all shadow-sm active:scale-[0.98] flex items-center justify-center text-xs">
                            <i class="fas fa-cart-plus mr-2 text-xs"></i> Thêm vào giỏ hàng
                        </button>
                        <a asp-action="Index" 
                           class="px-4 py-3 border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium rounded-md transition-colors text-xs flex items-center justify-center active:scale-[0.98]">
                            Quay lại
                        </a>
                    </div>
                </form>
            }
            else
            {
                <div class="mt-auto pt-5 border-t border-zinc-100 dark:border-zinc-800 flex gap-3">
                    <button disabled class="flex-1 bg-zinc-100 dark:bg-zinc-800 text-zinc-400 font-medium py-3 px-6 rounded-md cursor-not-allowed text-xs">
                        Sản phẩm tạm hết hàng
                    </button>
                    <a asp-action="Index" class="px-4 py-3 border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium rounded-md transition-colors text-xs">
                        Xem sản phẩm khác
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Tabs Thông số & Chính sách -->
    <div class="mt-8 bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
        <div class="flex border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 text-xs">
            <button class="py-3 px-6 font-semibold text-zinc-950 dark:text-white border-b-2 border-zinc-900 dark:border-zinc-100 bg-white dark:bg-zinc-900">Mô tả sản phẩm</button>
            <button class="py-3 px-6 font-medium text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">Bảo hành &amp; Đổi trả</button>
        </div>
        <div class="p-6 text-zinc-600 dark:text-zinc-400 leading-relaxed text-xs space-y-3">
            <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Chi tiết về @Model.Product.Name</h3>
            <p>
                @(string.IsNullOrWhiteSpace(Model.Product.Description) ? "Thông tin chi tiết đang được cập nhật." : Model.Product.Description)
            </p>
            <ul class="list-disc pl-4 space-y-1 text-zinc-600 dark:text-zinc-400">
                <li>Cam kết 100% hàng chính hãng, hóa đơn chứng từ đầy đủ.</li>
                <li>Đổi trả miễn phí trong vòng 7 ngày nếu có lỗi kỹ thuật từ nhà sản xuất.</li>
                <li>Hỗ trợ vận chuyển toàn quốc với mã vận đơn theo dõi lộ trình minh bạch.</li>
            </ul>
        </div>
    </div>

    <!-- Đánh giá sản phẩm -->
    <section id="reviews" class="mt-8 bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
        <div class="p-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6 pb-4 border-b border-zinc-100 dark:border-zinc-800">
                <div>
                    <h2 class="text-base font-bold text-zinc-950 dark:text-white">Đánh giá từ khách hàng</h2>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
                        @if (Model.ReviewCount > 0)
                        {
                            <span>@Model.AverageRating.ToString("0.0")/5 điểm từ <strong>@Model.ReviewCount</strong> đánh giá hợp lệ</span>
                        }
                        else
                        {
                            <span>Chưa có đánh giá nào cho sản phẩm này.</span>
                        }
                    </p>
                </div>
                @if (Model.ReviewCount > 0)
                {
                    <div class="flex items-center gap-1 text-amber-500">
                        @for (var star = 1; star <= 5; star++)
                        {
                            <i class="fas fa-star @(star <= Math.Round(Model.AverageRating) ? "" : "text-zinc-300 dark:text-zinc-700") text-xs"></i>
                        }
                    </div>
                }
            </div>

            @if (Model.CanReview)
            {
                <form asp-action="AddReview" method="post" class="mb-6 p-4 bg-zinc-50 dark:bg-zinc-800/40 rounded-md border border-zinc-200 dark:border-zinc-700">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Product.Id" />
                    <fieldset class="mb-3">
                        <legend class="font-medium text-zinc-800 dark:text-zinc-200 text-xs mb-1.5">Chấm điểm của bạn</legend>
                        <div class="flex items-center gap-1.5">
                            @for (var star = 1; star <= 5; star++)
                            {
                                <label class="cursor-pointer" title="@star sao">
                                    <input type="radio" name="Rating" value="@star" class="sr-only peer" checked="@(star == 5)" />
                                    <i class="far fa-star text-lg text-zinc-300 dark:text-zinc-600 peer-checked:text-amber-500 transition-colors"></i>
                                    <span class="sr-only">@star sao</span>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="NewReview.Rating" class="block mt-1 text-xs text-rose-600"></span>
                    </fieldset>
                    <label for="review-comment" class="block font-medium text-zinc-800 dark:text-zinc-200 text-xs mb-1.5">Nhận xét (không bắt buộc)</label>
                    <textarea id="review-comment" name="Comment" rows="3" maxlength="1000" placeholder="Chia sẻ cảm nhận thực tế của bạn..." 
                              class="w-full px-3 py-2 border border-zinc-200 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 text-xs focus:outline-none focus:border-zinc-900 dark:focus:border-zinc-100 transition-colors"></textarea>
                    <div class="mt-2.5 flex items-center justify-between">
                        <button type="submit" class="bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 hover:bg-zinc-800 dark:hover:bg-white font-medium py-1.5 px-4 rounded-md transition-colors text-xs active:scale-95 shadow-sm">
                            <i class="fas fa-paper-plane mr-1 text-[11px]"></i> Gửi đánh giá
                        </button>
                        <span class="text-[11px] text-zinc-400">Đánh giá sẽ được hiển thị sau khi kiểm duyệt.</span>
                    </div>
                </form>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <div class="mb-6 p-3 bg-zinc-100 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-md text-xs text-zinc-700 dark:text-zinc-300 flex items-center gap-2">
                    @if (Model.HasReviewed)
                    {
                        <i class="fas fa-check-circle text-emerald-500"></i>
                        <span>Bạn đã đánh giá sản phẩm này. Cảm ơn phản hồi của bạn!</span>
                    }
                    else
                    {
                        <i class="fas fa-info-circle text-zinc-400"></i>
                        <span>Chỉ khách đã mua và nhận hàng thành công mới có thể gửi đánh giá cho sản phẩm này.</span>
                    }
                </div>
            }
            else
            {
                <div class="mb-6 p-3 bg-zinc-100 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-md text-xs text-zinc-600 dark:text-zinc-400">
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="text-zinc-950 dark:text-white font-semibold underline">Đăng nhập</a>
                    để đánh giá sản phẩm sau khi bạn đã mua hàng.
                </div>
            }

            @if (Model.Reviews.Count > 0)
            {
                <div class="space-y-3">
                    @foreach (var review in Model.Reviews)
                    {
                        <article class="p-4 border border-zinc-100 dark:border-zinc-800 rounded-md bg-zinc-50/50 dark:bg-zinc-800/30">
                            <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                                <div class="flex items-center gap-2.5">
                                    <span class="font-semibold text-zinc-900 dark:text-zinc-100 text-xs">@DisplayName(review.User?.Email)</span>
                                    <span class="flex items-center gap-0.5 text-amber-500 text-[10px]">
                                        @for (var star = 1; star <= 5; star++)
                                        {
                                            <i class="fas fa-star @(star <= review.Rating ? "" : "text-zinc-300 dark:text-zinc-700")"></i>
                                        }
                                    </span>
                                </div>
                                <time class="text-[11px] text-zinc-400" datetime="@review.CreatedAt.ToString("O")">@review.CreatedAt.ToString("dd/MM/yyyy")</time>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="text-xs text-zinc-600 dark:text-zinc-400 whitespace-pre-line leading-relaxed">@review.Comment</p>
                            }
                            else
                            {
                                <p class="text-xs text-zinc-400 italic">Không có nhận xét chi tiết.</p>
                            }
                        </article>
                    }
                </div>
            }
        </div>
    </section>
</div>

@functions {
    private static string DisplayName(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return "Khách hàng";
        }

        var local = email.Split('@')[0];
        return (local.Length <= 3 ? local : local[..3]) + "***";
    }
}

<script>
    function decrementQty() {
        const input = document.getElementById('quantity-input');
        let val = parseInt(input.value) || 1;
        if (val > 1) {
            input.value = val - 1;
        }
    }
    function incrementQty(max) {
        const input = document.getElementById('quantity-input');
        let val = parseInt(input.value) || 1;
        if (val < max) {
            input.value = val + 1;
        }
    }
</script>
