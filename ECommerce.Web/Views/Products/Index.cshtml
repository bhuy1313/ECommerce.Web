@model ECommerce.Web.Models.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "Tất cả sản phẩm";
}

<!-- Breadcrumb -->
<div class="border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex text-xs text-zinc-500 dark:text-zinc-400 items-center">
            <a asp-controller="Home" asp-action="Index" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Trang chủ</a>
            <span class="mx-2 text-zinc-300 dark:text-zinc-700">/</span>
            <span class="text-zinc-900 dark:text-zinc-100 font-medium">Tất cả sản phẩm</span>
            @if (Model.SelectedCategoryId.HasValue)
            {
                var selectedCat = Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedCategoryId.Value);
                if (selectedCat != null)
                {
                    <span class="mx-2 text-zinc-300 dark:text-zinc-700">/</span>
                    <span class="text-zinc-950 dark:text-white font-semibold">@selectedCat.Name</span>
                }
            }
        </nav>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar Bộ Lọc (Cột trái) -->
        <aside class="w-full lg:w-64 flex-shrink-0">
            <div class="bg-white dark:bg-zinc-900 p-5 rounded-lg border border-zinc-200 dark:border-zinc-800 sticky top-24">
                <div class="flex items-center justify-between mb-4 border-b border-zinc-100 dark:border-zinc-800 pb-3">
                    <h3 class="font-semibold text-xs uppercase tracking-wider text-zinc-950 dark:text-white flex items-center gap-2">
                        <i class="fas fa-sliders-h text-xs text-zinc-400"></i> Bộ Lọc
                    </h3>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.SelectedCategoryId.HasValue)
                    {
                        <a asp-action="Index" class="text-xs text-zinc-500 hover:text-zinc-950 dark:hover:text-white font-medium underline">
                            Đặt lại
                        </a>
                    }
                </div>

                <!-- Tìm kiếm -->
                <form method="get" asp-action="Index" class="mb-5">
                    @if (Model.SelectedCategoryId.HasValue)
                    {
                        <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId.Value" />
                    }
                    <label class="block text-[11px] font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1.5">Tìm kiếm</label>
                    <div class="relative">
                        <input type="text" name="search" value="@Model.SearchQuery" placeholder="Tên sản phẩm..." 
                               class="w-full px-3 py-1.5 text-xs bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 rounded-md focus:outline-none focus:border-zinc-900 dark:focus:border-zinc-100 text-zinc-900 dark:text-zinc-100 pr-8 transition-colors">
                        <button type="submit" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-900 dark:hover:text-white" aria-label="Tìm kiếm">
                            <i class="fas fa-search text-xs"></i>
                        </button>
                    </div>
                </form>

                <!-- Danh mục -->
                <div>
                    <h4 class="font-semibold text-[11px] text-zinc-500 dark:text-zinc-400 mb-2 uppercase tracking-wider">Danh mục</h4>
                    <ul class="space-y-1 text-xs">
                        <li>
                            <a asp-action="Index" asp-route-search="@Model.SearchQuery" 
                               class="flex items-center justify-between px-2.5 py-1.5 rounded-md transition-colors @(Model.SelectedCategoryId == null ? "bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-950 font-medium" : "text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800")">
                                <span>Tất cả</span>
                                <span class="text-[10px] px-1.5 py-0.2 rounded @(Model.SelectedCategoryId == null ? "bg-zinc-800 text-zinc-200 dark:bg-zinc-200 dark:text-zinc-800" : "bg-zinc-100 dark:bg-zinc-800 text-zinc-500")">@Model.Products.Count()</span>
                            </a>
                        </li>
                        @foreach (var cat in Model.Categories)
                        {
                            var isSelected = Model.SelectedCategoryId == cat.Id;
                            <li>
                                <a asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-search="@Model.SearchQuery" 
                                   class="flex items-center justify-between px-2.5 py-1.5 rounded-md transition-colors @(isSelected ? "bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-950 font-medium" : "text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800")">
                                    <span class="truncate mr-2">@cat.Name</span>
                                    <i class="fas fa-chevron-right text-[10px] @(isSelected ? "text-zinc-400 dark:text-zinc-600" : "text-zinc-300 dark:text-zinc-700")"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </aside>

        <!-- Danh sách sản phẩm (Cột phải) -->
        <div class="flex-1">
            <!-- Top Bar -->
            <div class="bg-white dark:bg-zinc-900 px-4 py-3 rounded-lg border border-zinc-200 dark:border-zinc-800 flex flex-wrap justify-between items-center mb-6 text-xs">
                <div>
                    <span class="font-semibold text-zinc-900 dark:text-zinc-100">Danh mục sản phẩm</span>
                    <span class="text-zinc-500 dark:text-zinc-400 ml-2">(<strong>@Model.Products.Count()</strong> sản phẩm)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <div class="inline-flex items-center gap-1.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 px-2.5 py-1 rounded text-xs">
                        <span>Từ khóa: "<strong>@Model.SearchQuery</strong>"</span>
                        <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" class="hover:text-zinc-950 dark:hover:text-white" title="Xóa từ khóa">
                            <i class="fas fa-times-circle text-[11px]"></i>
                        </a>
                    </div>
                }
            </div>

            <!-- Product Grid -->
            @if (!Model.Products.Any())
            {
                <div class="bg-white dark:bg-zinc-900 rounded-lg p-12 text-center border border-zinc-200 dark:border-zinc-800">
                    <div class="w-12 h-12 bg-zinc-100 dark:bg-zinc-800 rounded-md flex items-center justify-center mx-auto mb-3 text-zinc-400 text-xl">
                        <i class="fas fa-box-open"></i>
                    </div>
                    <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Không tìm thấy sản phẩm nào</h3>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 max-w-sm mx-auto mb-5">Không có sản phẩm nào khớp với tiêu chí tìm kiếm. Hãy thử tìm từ khóa khác hoặc xóa bộ lọc.</p>
                    <a asp-action="Index" class="inline-flex items-center px-4 py-2 rounded-md bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 text-xs font-medium hover:bg-zinc-800 dark:hover:bg-white transition-colors active:scale-95 shadow-sm">
                        Xem tất cả sản phẩm
                    </a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
                    @foreach (var product in Model.Products)
                    {
                        <div class="group bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all flex flex-col overflow-hidden">
                            <!-- Vùng ảnh sản phẩm -->
                            <div class="relative aspect-square bg-zinc-50 dark:bg-zinc-800/40 p-5 flex items-center justify-center overflow-hidden border-b border-zinc-100 dark:border-zinc-800/60">
                                @if (product.StockQuantity <= 0)
                                {
                                    <span class="absolute top-2.5 left-2.5 z-10 px-2 py-0.5 rounded text-[11px] font-medium bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900">
                                        Hết hàng
                                    </span>
                                }
                                else if (product.StockQuantity <= 15)
                                {
                                    <span class="absolute top-2.5 left-2.5 z-10 px-2 py-0.5 rounded text-[11px] font-medium bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                                        Còn @product.StockQuantity sp
                                    </span>
                                }
                                else
                                {
                                    <span class="absolute top-2.5 left-2.5 z-10 px-2 py-0.5 rounded text-[11px] font-medium text-zinc-600 dark:text-zinc-400 bg-white/90 dark:bg-zinc-800/90 border border-zinc-200/80 dark:border-zinc-700/80">
                                        @product.Category?.Name
                                    </span>
                                }

                                <a asp-action="Details" asp-route-id="@product.Id" class="w-full h-full flex items-center justify-center" aria-label="Xem @product.Name">
                                    <img src="@ProductImage.Resolve(product.ImageUrl)" alt="@product.Name" loading="lazy" 
                                         class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300">
                                </a>
                            </div>

                            <!-- Thông tin sản phẩm -->
                            <div class="p-4 flex flex-col flex-grow">
                                <div class="text-[11px] uppercase tracking-wider text-zinc-400 font-medium mb-1">
                                    @product.Category?.Name
                                </div>
                                <div class="flex items-center gap-1.5 text-xs mb-1.5">
                                    @if (Model.Ratings.TryGetValue(product.Id, out var rating) && rating.Count > 0)
                                    {
                                        <span class="text-amber-500"><i class="fas fa-star text-[11px]"></i></span>
                                        <span class="font-semibold text-zinc-800 dark:text-zinc-200">@rating.AverageRating.ToString("0.0")</span>
                                        <span class="text-zinc-400 text-[11px]">(@rating.Count)</span>
                                    }
                                    else
                                    {
                                        <span class="text-zinc-400 text-[11px]">Chưa có đánh giá</span>
                                    }
                                </div>
                                <h3 class="text-sm font-medium text-zinc-900 dark:text-zinc-100 group-hover:text-zinc-600 dark:group-hover:text-zinc-300 line-clamp-2 transition-colors leading-snug mb-2">
                                    <a asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                                </h3>
                                <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 mb-4 leading-relaxed">
                                    @(string.IsNullOrWhiteSpace(product.Description) ? "Sản phẩm chính hãng với bảo hành tiêu chuẩn." : product.Description)
                                </p>

                                <div class="mt-auto pt-3 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between gap-2">
                                    <div>
                                        <span class="text-base font-bold text-zinc-950 dark:text-white tracking-tight">
                                            <vc:money amount="@product.Price" />
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <a asp-action="Details" asp-route-id="@product.Id" 
                                           class="w-8 h-8 rounded-md border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors flex items-center justify-center text-xs active:scale-95" 
                                           title="Xem chi tiết" aria-label="Xem chi tiết @product.Name">
                                            <i class="fas fa-eye" aria-hidden="true"></i>
                                        </a>
                                        @if (product.StockQuantity > 0)
                                        {
                                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                <button type="submit" 
                                                        class="w-8 h-8 rounded-md bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 hover:bg-zinc-800 dark:hover:bg-white transition-colors flex items-center justify-center text-xs shadow-sm active:scale-95" 
                                                        title="Thêm vào giỏ" aria-label="Thêm @product.Name vào giỏ">
                                                    <i class="fas fa-cart-plus" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
