@model IReadOnlyList<ECommerce.Web.Models.Entities.Review>
@{
    ViewData["Title"] = "Kiểm duyệt đánh giá";
    var status = ViewBag.Status as string ?? "pending";
}

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h1 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <i class="fas fa-star text-zinc-400 text-base"></i>Kiểm duyệt đánh giá
        </h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Duyệt đánh giá trước khi hiển thị công khai trên trang sản phẩm</p>
    </div>
    <div class="flex items-center gap-1.5">
        <a asp-action="Reviews" asp-route-status="pending" class="px-3 py-1.5 rounded-md text-xs font-medium border transition-all active:scale-[0.98] @(status == "pending" ? "bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 border-zinc-900 dark:border-zinc-100" : "bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border-zinc-200 dark:border-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-800")">
            Chờ duyệt
        </a>
        <a asp-action="Reviews" asp-route-status="approved" class="px-3 py-1.5 rounded-md text-xs font-medium border transition-all active:scale-[0.98] @(status == "approved" ? "bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 border-zinc-900 dark:border-zinc-100" : "bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border-zinc-200 dark:border-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-800")">
            Đã duyệt
        </a>
        <a asp-action="Reviews" asp-route-status="all" class="px-3 py-1.5 rounded-md text-xs font-medium border transition-all active:scale-[0.98] @(status == "all" ? "bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 border-zinc-900 dark:border-zinc-100" : "bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border-zinc-200 dark:border-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-800")">
            Tất cả
        </a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 p-10 text-center text-xs text-zinc-400">
        <i class="fas fa-inbox text-2xl mb-2 text-zinc-300 dark:text-zinc-700 block"></i>
        <p>Không có đánh giá nào trong mục này.</p>
    </div>
}
else
{
    <div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
            <table class="w-full text-xs">
                <thead class="bg-zinc-50/75 dark:bg-zinc-800/40 text-zinc-500 dark:text-zinc-400 uppercase tracking-wider text-[11px] border-b border-zinc-200 dark:border-zinc-800">
                    <tr>
                        <th class="text-left font-medium px-4 py-2.5">Sản phẩm</th>
                        <th class="text-left font-medium px-4 py-2.5">Người đánh giá</th>
                        <th class="text-left font-medium px-4 py-2.5">Điểm</th>
                        <th class="text-left font-medium px-4 py-2.5">Nội dung</th>
                        <th class="text-left font-medium px-4 py-2.5">Ngày</th>
                        <th class="text-right font-medium px-4 py-2.5">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                    @foreach (var review in Model)
                    {
                        <tr class="align-top hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition-colors">
                            <td class="px-4 py-3">
                                <a asp-action="ProductForm" asp-route-id="@review.ProductId" class="font-medium text-zinc-900 dark:text-zinc-100 hover:underline">
                                    @(review.Product?.Name ?? $"#{review.ProductId}")
                                </a>
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-zinc-500 dark:text-zinc-400">
                                @DisplayName(review.User?.Email)
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-amber-500">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    <i class="fas fa-star text-[11px] @(star <= review.Rating ? "" : "text-zinc-200 dark:text-zinc-700")"></i>
                                }
                            </td>
                            <td class="px-4 py-3 max-w-md">
                                @if (string.IsNullOrWhiteSpace(review.Comment))
                                {
                                    <span class="text-zinc-400 italic">Không có nhận xét.</span>
                                }
                                else
                                {
                                    <span class="text-zinc-700 dark:text-zinc-300 whitespace-pre-line">@review.Comment</span>
                                }
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-zinc-400">
                                @review.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="px-4 py-3 whitespace-nowrap text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    @if (!review.IsApproved)
                                    {
                                        <form asp-action="ApproveReview" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@review.Id" />
                                            <button type="submit" class="px-2.5 py-1 rounded bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50 hover:bg-emerald-100 text-xs font-medium active:scale-[0.98] transition-all">
                                                <i class="fas fa-check mr-1 text-[10px]"></i>Duyệt
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700 text-xs font-medium">Đã duyệt</span>
                                    }
                                    <form asp-action="DeleteReview" method="post" onsubmit="return confirm('Xóa đánh giá này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@review.Id" />
                                        <button type="submit" class="px-2.5 py-1 rounded bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 hover:bg-rose-100 text-xs font-medium active:scale-[0.98] transition-all">
                                            <i class="fas fa-trash mr-1 text-[10px]"></i>Xóa
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@functions {
    private static string DisplayName(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return "Khách hàng";
        }

        var local = email.Split('@')[0];
        return (local.Length <= 3 ? local : local[..3]) + "***";
    }
}