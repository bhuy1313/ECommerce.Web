@model ECommerce.Web.Models.ViewModels.CouponFormViewModel
@using ECommerce.Web.Models.Entities.Enums
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Cập nhật mã giảm giá" : "Thêm mã giảm giá";
}

<div class="max-w-2xl mx-auto py-4">
    <nav class="flex text-xs text-slate-400 mb-6 items-center">
        <a asp-action="Index" class="hover:text-primary dark:hover:text-indigo-300 transition-colors">Dashboard</a>
        <span class="mx-2 text-slate-300">/</span>
        <a asp-action="Coupons" class="hover:text-primary dark:hover:text-indigo-300 transition-colors">Mã giảm giá</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700 dark:text-gray-300 font-medium">@(isEdit ? $"Cập nhật #{Model.Id}" : "Thêm mới")</span>
    </nav>

    <div class="bg-white dark:bg-gray-900 rounded-3xl shadow-sm border border-slate-100 dark:border-gray-800 p-6 sm:p-10">
        <div class="flex items-center space-x-3 pb-6 mb-6 border-b border-slate-100 dark:border-gray-800">
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-900/40 text-primary dark:text-indigo-300 flex items-center justify-center text-xl">
                <i class="fas @(isEdit ? "fa-edit" : "fa-ticket-alt")"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-gray-100">
                    @(isEdit ? $"Cập nhật mã: {Model.Code}" : "Tạo mã giảm giá mới")
                </h1>
                <p class="text-xs text-slate-400 mt-0.5">Thiết lập giá trị giảm, thời hạn và số lượt sử dụng tối đa</p>
            </div>
        </div>

        <form asp-action="@(isEdit ? "EditCoupon" : "CreateCoupon")" method="post" novalidate class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="p-4 bg-rose-50 border border-rose-200 text-rose-700 rounded-2xl text-xs" role="alert"></div>

            <div>
                <label asp-for="Code" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                <input asp-for="Code" class="w-full px-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl uppercase focus:ring-2 focus:ring-primary focus:outline-none transition-all" placeholder="Ví dụ: SAVE10" />
                <span asp-validation-for="Code" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label asp-for="DiscountType" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                    <select asp-for="DiscountType" asp-items="Html.GetEnumSelectList<DiscountType>()"
                            class="w-full px-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none transition-all"></select>
                    <span asp-validation-for="DiscountType" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Value" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                    <input asp-for="Value" type="number" step="0.01" min="0.01" class="w-full px-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none transition-all" placeholder="10" />
                    <span asp-validation-for="Value" class="text-xs text-rose-500 mt-1 block"></span>
                    <p class="text-[11px] text-slate-400 mt-1">Phần trăm (1–100) hoặc số tiền giảm cố định.</p>
                </div>
                <div>
                    <label asp-for="MinOrderAmount" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                    <input asp-for="MinOrderAmount" type="number" step="1000" min="0" class="w-full px-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none transition-all" placeholder="0" />
                    <span asp-validation-for="MinOrderAmount" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="UsageLimit" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                    <input asp-for="UsageLimit" type="number" min="1" class="w-full px-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none transition-all" placeholder="100" />
                    <span asp-validation-for="UsageLimit" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="StartsOn" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                    <input asp-for="StartsOn" type="date" class="w-full px-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none transition-all" />
                    <span asp-validation-for="StartsOn" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="EndsOn" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                    <input asp-for="EndsOn" type="date" class="w-full px-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none transition-all" />
                    <span asp-validation-for="EndsOn" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <div class="p-4 bg-slate-50 dark:bg-gray-800 rounded-2xl border border-slate-100 dark:border-gray-800 flex items-start space-x-3">
                <input asp-for="IsActive" type="checkbox" class="mt-1 h-4 w-4 text-primary dark:text-indigo-300 focus:ring-primary border-slate-300 dark:border-gray-600 rounded cursor-pointer" />
                <div>
                    <label asp-for="IsActive" class="text-xs font-bold text-slate-800 dark:text-gray-200 cursor-pointer"></label>
                    <p class="text-xs text-slate-400 mt-0.5">Khi tắt, khách không thể áp dụng mã này tại bước thanh toán.</p>
                </div>
            </div>

            <div class="flex items-center justify-between pt-6 border-t border-slate-100 dark:border-gray-800">
                <a asp-action="Coupons" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-gray-700 text-slate-600 dark:text-gray-400 hover:bg-slate-50 dark:hover:bg-gray-800 text-sm font-medium transition-colors">
                    Hủy bỏ
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary hover:bg-indigo-700 text-white text-sm font-semibold shadow-md transition-colors">
                    @(isEdit ? "Lưu thay đổi" : "Tạo mã giảm giá")
                </button>
            </div>
        </form>
    </div>
</div>
