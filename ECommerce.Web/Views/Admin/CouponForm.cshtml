@model ECommerce.Web.Models.ViewModels.CouponFormViewModel
@using ECommerce.Web.Models.Entities.Enums
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Cập nhật mã giảm giá" : "Thêm mã giảm giá";
}

<div class="max-w-2xl mx-auto py-2">
    <nav class="flex text-xs text-zinc-500 dark:text-zinc-400 mb-6 items-center gap-1.5" aria-label="Breadcrumb">
        <a asp-action="Index" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Dashboard</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <a asp-action="Coupons" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Mã giảm giá</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <span class="text-zinc-900 dark:text-zinc-100 font-medium">@(isEdit ? $"Cập nhật #{Model.Id}" : "Thêm mới")</span>
    </nav>

    <div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 p-6 sm:p-8 shadow-xs">
        <div class="flex items-center space-x-3 pb-5 mb-5 border-b border-zinc-200 dark:border-zinc-800">
            <div class="w-9 h-9 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-sm border border-zinc-200 dark:border-zinc-700">
                <i class="fas @(isEdit ? "fa-edit" : "fa-ticket-alt")"></i>
            </div>
            <div>
                <h1 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
                    @(isEdit ? $"Cập nhật mã: {Model.Code}" : "Tạo mã giảm giá mới")
                </h1>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Thiết lập giá trị giảm, thời hạn và số lượt sử dụng tối đa</p>
            </div>
        </div>

        <form asp-action="@(isEdit ? "EditCoupon" : "CreateCoupon")" method="post" novalidate class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="p-2.5 bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/40 text-rose-700 dark:text-rose-300 rounded-md text-xs" role="alert"></div>

            <div>
                <label asp-for="Code" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                <input asp-for="Code" class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 uppercase focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100 font-mono" placeholder="Ví dụ: SAVE10" />
                <span asp-validation-for="Code" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="DiscountType" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                    <select asp-for="DiscountType" asp-items="Html.GetEnumSelectList<DiscountType>()"
                            class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100"></select>
                    <span asp-validation-for="DiscountType" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Value" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                    <input asp-for="Value" type="number" step="0.01" min="0.01" class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" placeholder="10" />
                    <span asp-validation-for="Value" class="text-xs text-rose-500 mt-1 block"></span>
                    <p class="text-[10px] text-zinc-400 mt-0.5">Phần trăm (1–100) hoặc số tiền giảm cố định.</p>
                </div>
                <div>
                    <label asp-for="MinOrderAmount" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                    <input asp-for="MinOrderAmount" type="number" step="1000" min="0" class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" placeholder="0" />
                    <span asp-validation-for="MinOrderAmount" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="UsageLimit" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                    <input asp-for="UsageLimit" type="number" min="1" class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" placeholder="100" />
                    <span asp-validation-for="UsageLimit" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="StartsOn" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                    <input asp-for="StartsOn" type="date" class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" />
                    <span asp-validation-for="StartsOn" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="EndsOn" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                    <input asp-for="EndsOn" type="date" class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" />
                    <span asp-validation-for="EndsOn" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <div class="p-3 bg-zinc-50 dark:bg-zinc-800/40 rounded-md border border-zinc-200 dark:border-zinc-800 flex items-start space-x-2.5">
                <input asp-for="IsActive" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-zinc-300 dark:border-zinc-700 text-zinc-900 accent-zinc-900 dark:accent-zinc-100 cursor-pointer" />
                <div>
                    <label asp-for="IsActive" class="text-xs font-medium text-zinc-900 dark:text-zinc-200 cursor-pointer"></label>
                    <p class="text-[11px] text-zinc-500 dark:text-zinc-400">Khi tắt, khách không thể áp dụng mã này tại bước thanh toán.</p>
                </div>
            </div>

            <div class="flex items-center justify-between pt-5 border-t border-zinc-200 dark:border-zinc-800">
                <a asp-action="Coupons" class="px-3.5 py-1.5 rounded-md border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800 text-xs font-medium active:scale-[0.98] transition-all">
                    Hủy bỏ
                </a>
                <button type="submit" class="px-4 py-2 rounded-md bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 text-xs font-medium active:scale-[0.98] transition-all shadow-sm">
                    @(isEdit ? "Lưu thay đổi" : "Tạo mã giảm giá")
                </button>
            </div>
        </form>
    </div>
</div>