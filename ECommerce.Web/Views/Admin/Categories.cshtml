@model IEnumerable<ECommerce.Web.Models.Entities.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-gray-100 flex items-center">
            <i class="fas fa-tags text-primary dark:text-indigo-300 mr-3 text-2xl"></i>Quản lý Danh mục
        </h1>
        <p class="text-sm text-slate-500 dark:text-gray-400 mt-1">Phân loại nhóm ngành hàng, cấu trúc danh mục và kiểm soát trạng thái hiển thị</p>
    </div>
    <a asp-action="CreateCategory" class="inline-flex items-center px-4 py-2.5 rounded-xl bg-primary hover:bg-indigo-700 text-white text-sm font-semibold shadow-md transition-colors w-max">
        <i class="fas fa-plus mr-2 text-xs"></i> Thêm danh mục mới
    </a>
</div>

<!-- Bảng danh mục -->
<div class="bg-white dark:bg-gray-900 rounded-3xl shadow-sm border border-slate-100 dark:border-gray-800 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 dark:bg-gray-800 text-slate-400 text-xs uppercase tracking-wider border-b border-slate-100 dark:border-gray-800">
                <tr>
                    <th class="py-4 px-6 font-semibold w-16">ID</th>
                    <th class="py-4 px-6 font-semibold">Tên danh mục</th>
                    <th class="py-4 px-6 font-semibold">Mô tả</th>
                    <th class="py-4 px-6 font-semibold text-center">Số sản phẩm</th>
                    <th class="py-4 px-6 font-semibold text-center">Trạng thái</th>
                    <th class="py-4 px-6 font-semibold text-right">Hành động</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-gray-800">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="py-12 text-center text-slate-400">
                            Chưa có danh mục nào được khởi tạo.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var category in Model)
                    {
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-gray-800/50 transition-colors">
                            <td class="py-4 px-6 font-bold text-slate-400 text-xs">
                                #@category.Id
                            </td>
                            <td class="py-4 px-6">
                                <div class="font-bold text-slate-900 dark:text-gray-100 text-sm">@category.Name</div>
                            </td>
                            <td class="py-4 px-6 text-slate-500 dark:text-gray-400 text-xs">
                                @(string.IsNullOrWhiteSpace(category.Description) ? "—" : category.Description)
                            </td>
                            <td class="py-4 px-6 text-center">
                                <span class="inline-block px-3 py-1 bg-slate-100 dark:bg-gray-800 text-slate-700 dark:text-gray-300 text-xs font-bold rounded-full">
                                    @category.Products.Count sản phẩm
                                </span>
                            </td>
                            <td class="py-4 px-6 text-center">
                                @if (category.IsActive)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-full border border-emerald-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span> Đang kích hoạt
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 bg-slate-100 dark:bg-gray-800 text-slate-500 dark:text-gray-400 text-xs font-semibold rounded-full border border-slate-200 dark:border-gray-700">
                                        Đã ẩn
                                    </span>
                                }
                            </td>
                            <td class="py-4 px-6 text-right">
                                <div class="inline-flex items-center gap-2">
                                    <a asp-action="EditCategory" asp-route-id="@category.Id" class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-gray-800 hover:bg-slate-200 dark:hover:bg-gray-700 text-slate-700 dark:text-gray-300 text-xs font-semibold transition-colors">
                                        <i class="fas fa-edit mr-1"></i> Sửa
                                    </a>
                                    <form asp-action="ToggleCategoryStatus" asp-route-id="@category.Id" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors @(category.IsActive ? "bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200" : "bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200")">
                                            @(category.IsActive ? "Ẩn" : "Hiện")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
