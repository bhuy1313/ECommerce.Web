@model IEnumerable<ECommerce.Web.Models.Entities.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h1 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <i class="fas fa-tags text-zinc-400 text-base"></i>Quản lý Danh mục
        </h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Phân loại nhóm ngành hàng, cấu trúc danh mục và kiểm soát trạng thái hiển thị</p>
    </div>
    <a asp-action="CreateCategory" class="inline-flex items-center px-3 py-1.5 rounded-md bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 text-xs font-medium active:scale-[0.98] transition-all w-max shadow-sm">
        <i class="fas fa-plus mr-1.5 text-xs"></i> Thêm danh mục mới
    </a>
</div>

<!-- Bảng danh mục -->
<div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden shadow-xs">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
            <thead class="bg-zinc-50/75 dark:bg-zinc-800/40 text-zinc-500 dark:text-zinc-400 uppercase tracking-wider text-[11px] border-b border-zinc-200 dark:border-zinc-800">
                <tr>
                    <th class="py-2.5 px-4 font-medium w-16">ID</th>
                    <th class="py-2.5 px-4 font-medium">Tên danh mục</th>
                    <th class="py-2.5 px-4 font-medium">Mô tả</th>
                    <th class="py-2.5 px-4 font-medium text-center">Số sản phẩm</th>
                    <th class="py-2.5 px-4 font-medium text-center">Trạng thái</th>
                    <th class="py-2.5 px-4 font-medium text-right">Hành động</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="py-10 text-center text-zinc-400">
                            Chưa có danh mục nào được khởi tạo.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var category in Model)
                    {
                        <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition-colors">
                            <td class="py-3 px-4 font-mono font-medium text-zinc-400 text-xs">
                                #@category.Id
                            </td>
                            <td class="py-3 px-4">
                                <div class="font-medium text-zinc-900 dark:text-zinc-100 text-xs">@category.Name</div>
                            </td>
                            <td class="py-3 px-4 text-zinc-500 dark:text-zinc-400 text-xs">
                                @(string.IsNullOrWhiteSpace(category.Description) ? "—" : category.Description)
                            </td>
                            <td class="py-3 px-4 text-center">
                                <span class="inline-block px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-[11px] font-medium rounded border border-zinc-200 dark:border-zinc-700">
                                    @category.Products.Count sản phẩm
                                </span>
                            </td>
                            <td class="py-3 px-4 text-center">
                                @if (category.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 text-[11px] font-medium rounded border border-emerald-200 dark:border-emerald-800/50">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span> Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 text-[11px] font-medium rounded border border-zinc-200 dark:border-zinc-700">
                                        Đã ẩn
                                    </span>
                                }
                            </td>
                            <td class="py-3 px-4 text-right">
                                <div class="inline-flex items-center gap-1.5">
                                    <a asp-action="EditCategory" asp-route-id="@category.Id" class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 text-xs font-medium active:scale-[0.98] transition-all">
                                        <i class="fas fa-edit mr-1 text-[10px]"></i> Sửa
                                    </a>
                                    <form asp-action="ToggleCategoryStatus" asp-route-id="@category.Id" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="px-2.5 py-1 rounded text-xs font-medium active:scale-[0.98] transition-all @(category.IsActive ? "bg-amber-50 dark:bg-amber-950/30 hover:bg-amber-100 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800/50" : "bg-emerald-50 dark:bg-emerald-950/30 hover:bg-emerald-100 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50")" title="@(category.IsActive ? "Ẩn danh mục" : "Kích hoạt lại")">
                                            @(category.IsActive ? "Ẩn" : "Hiện")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>