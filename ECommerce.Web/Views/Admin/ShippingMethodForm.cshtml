@model ECommerce.Web.Models.ViewModels.ShippingMethodFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Sửa phương thức vận chuyển" : "Thêm phương thức vận chuyển";
}

<div class="max-w-2xl">
    <div class="flex items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-gray-100">@ViewData["Title"]</h1>
            <p class="text-sm text-slate-500 dark:text-gray-400 mt-1">Phí này được tính lại ở server khi khách đặt hàng</p>
        </div>
        <a asp-action="ShippingMethods" class="text-sm font-medium text-slate-500 dark:text-gray-400 hover:text-slate-800 dark:hover:text-gray-200">
            <i class="fas fa-arrow-left mr-1"></i>Quay lại
        </a>
    </div>

    <form asp-action="@(isEdit ? "EditShippingMethod" : "CreateShippingMethod")" method="post" class="bg-white dark:bg-gray-900 rounded-2xl border border-slate-100 dark:border-gray-800 p-6 sm:p-8 space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="Name" class="block font-medium text-slate-700 dark:text-gray-300 text-sm mb-1"></label>
            <input asp-for="Name" class="w-full px-3.5 py-2.5 border border-slate-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-800 text-slate-800 dark:text-gray-200 focus:ring-primary focus:border-primary" placeholder="Ví dụ: Giao hàng tiêu chuẩn" />
            <span asp-validation-for="Name" class="block mt-1 text-xs text-red-600"></span>
        </div>

        <div>
            <label asp-for="Description" class="block font-medium text-slate-700 dark:text-gray-300 text-sm mb-1"></label>
            <textarea asp-for="Description" rows="2" class="w-full px-3.5 py-2.5 border border-slate-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-800 text-slate-800 dark:text-gray-200 focus:ring-primary focus:border-primary" placeholder="Thời gian giao hàng dự kiến..."></textarea>
            <span asp-validation-for="Description" class="block mt-1 text-xs text-red-600"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                <label asp-for="Fee" class="block font-medium text-slate-700 dark:text-gray-300 text-sm mb-1"></label>
                <input asp-for="Fee" type="number" min="0" step="1000" class="w-full px-3.5 py-2.5 border border-slate-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-800 text-slate-800 dark:text-gray-200 focus:ring-primary focus:border-primary" />
                <span asp-validation-for="Fee" class="block mt-1 text-xs text-red-600"></span>
            </div>
            <div>
                <label asp-for="DisplayOrder" class="block font-medium text-slate-700 dark:text-gray-300 text-sm mb-1"></label>
                <input asp-for="DisplayOrder" type="number" min="0" step="1" class="w-full px-3.5 py-2.5 border border-slate-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-800 text-slate-800 dark:text-gray-200 focus:ring-primary focus:border-primary" />
                <span asp-validation-for="DisplayOrder" class="block mt-1 text-xs text-red-600"></span>
            </div>
        </div>

        <label class="flex items-center gap-3 cursor-pointer">
            <input asp-for="IsActive" class="h-4 w-4 text-primary focus:ring-primary rounded" />
            <span class="text-sm font-medium text-slate-700 dark:text-gray-300">Hiển thị phương thức này ở bước thanh toán</span>
        </label>

        <div class="flex items-center gap-3 pt-2">
            <button type="submit" class="bg-primary hover:bg-indigo-700 text-white font-bold py-2.5 px-5 rounded-xl transition-colors text-sm">
                <i class="fas fa-save mr-1.5"></i>@(isEdit ? "Lưu thay đổi" : "Tạo phương thức")
            </button>
            <a asp-action="ShippingMethods" class="text-sm font-medium text-slate-500 hover:text-slate-800 dark:hover:text-gray-200">Hủy</a>
        </div>
    </form>
</div>
