@model ECommerce.Web.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan Dashboard";
}

<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h1 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <i class="fas fa-chart-pie text-zinc-400 text-base"></i>Tổng quan hệ thống
        </h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Giám sát doanh thu, đơn hàng, trạng thái kho vận và tài khoản người dùng</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        <a asp-action="Coupons" class="inline-flex items-center px-3 py-1.5 rounded-md bg-white dark:bg-zinc-900 hover:bg-zinc-50 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-medium active:scale-[0.98] transition-all">
            <i class="fas fa-ticket-alt mr-1.5 text-zinc-400 text-xs"></i> Mã giảm giá
        </a>
        <a asp-action="Reviews" class="inline-flex items-center px-3 py-1.5 rounded-md bg-white dark:bg-zinc-900 hover:bg-zinc-50 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-medium active:scale-[0.98] transition-all">
            <i class="fas fa-star mr-1.5 text-zinc-400 text-xs"></i> Đánh giá
        </a>
        <a asp-action="ShippingMethods" class="inline-flex items-center px-3 py-1.5 rounded-md bg-white dark:bg-zinc-900 hover:bg-zinc-50 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-medium active:scale-[0.98] transition-all">
            <i class="fas fa-truck mr-1.5 text-zinc-400 text-xs"></i> Vận chuyển
        </a>
        <a asp-action="Products" class="inline-flex items-center px-3 py-1.5 rounded-md bg-white dark:bg-zinc-900 hover:bg-zinc-50 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-medium active:scale-[0.98] transition-all">
            <i class="fas fa-boxes mr-1.5 text-zinc-400 text-xs"></i> Kho hàng
        </a>
        <a asp-action="ProductForm" class="inline-flex items-center px-3 py-1.5 rounded-md bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 text-xs font-medium active:scale-[0.98] transition-all">
            <i class="fas fa-plus mr-1 text-xs"></i> Thêm SP
        </a>
    </div>
</div>

<!-- 4 Thẻ KPI chính -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
    <!-- Card 1: Doanh thu -->
    <div class="bg-white dark:bg-zinc-900 rounded-lg p-4 sm:p-5 border border-zinc-200 dark:border-zinc-800 flex items-start justify-between">
        <div>
            <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-500">Tổng doanh thu</span>
            <div class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-1">@Model.TotalRevenue.ToString("N0") đ</div>
            <p class="text-[11px] text-zinc-400 mt-1 flex items-center gap-1">
                <i class="fas fa-check text-emerald-500 text-[10px]"></i> Tính trên đơn hợp lệ
            </p>
        </div>
        <div class="w-9 h-9 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-sm">
            <i class="fas fa-coins"></i>
        </div>
    </div>

    <!-- Card 2: Đơn hàng -->
    <div class="bg-white dark:bg-zinc-900 rounded-lg p-4 sm:p-5 border border-zinc-200 dark:border-zinc-800 flex items-start justify-between">
        <div>
            <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-500">Tổng đơn hàng</span>
            <div class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-1">@Model.TotalOrders</div>
            <p class="text-[11px] text-zinc-400 mt-1">
                Chờ duyệt: <strong class="text-amber-600 dark:text-amber-400 font-semibold">@Model.PendingOrders</strong> · Xong: <strong class="text-emerald-600 dark:text-emerald-400 font-semibold">@Model.CompletedOrders</strong>
            </p>
        </div>
        <div class="w-9 h-9 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-sm">
            <i class="fas fa-shopping-cart"></i>
        </div>
    </div>

    <!-- Card 3: Sản phẩm -->
    <div class="bg-white dark:bg-zinc-900 rounded-lg p-4 sm:p-5 border border-zinc-200 dark:border-zinc-800 flex items-start justify-between">
        <div>
            <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-500">Sản phẩm & Danh mục</span>
            <div class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-1">@Model.TotalProducts</div>
            <p class="text-[11px] text-zinc-400 mt-1">
                Đang bán: <strong class="text-zinc-700 dark:text-zinc-300 font-semibold">@Model.ActiveProducts</strong> · Danh mục: <strong class="text-zinc-700 dark:text-zinc-300 font-semibold">@Model.TotalCategories</strong>
            </p>
        </div>
        <div class="w-9 h-9 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-sm">
            <i class="fas fa-box-open"></i>
        </div>
    </div>

    <!-- Card 4: Người dùng & Tồn kho -->
    <div class="bg-white dark:bg-zinc-900 rounded-lg p-4 sm:p-5 border border-zinc-200 dark:border-zinc-800 flex items-start justify-between">
        <div>
            <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-500">Khách hàng & Tồn kho</span>
            <div class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-1">@Model.TotalUsers <span class="text-xs text-zinc-400 font-normal">users</span></div>
            <p class="text-[11px] mt-1 @(Model.LowStockCount > 0 ? "text-rose-600 dark:text-rose-400 font-medium" : "text-zinc-400")">
                <i class="fas fa-exclamation-triangle mr-1 text-[10px]"></i> Tồn kho ít (&lt;@ECommerce.Web.Models.Constants.AppConstants.LowStockThreshold): @Model.LowStockCount
            </p>
        </div>
        <div class="w-9 h-9 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-sm">
            <i class="fas fa-users"></i>
        </div>
    </div>
</div>

<!-- Lọc nhanh trạng thái đơn hàng -->
<div class="bg-white dark:bg-zinc-900 rounded-lg p-3.5 border border-zinc-200 dark:border-zinc-800 mb-6 flex flex-wrap items-center gap-2 text-xs">
    <span class="text-[11px] font-medium text-zinc-500 uppercase tracking-wider mr-1">Trạng thái:</span>
    <a asp-action="Orders" asp-route-status="Pending" class="inline-flex items-center px-2.5 py-1 rounded bg-amber-50 dark:bg-amber-950/30 hover:bg-amber-100 dark:hover:bg-amber-900/40 text-amber-800 dark:text-amber-300 font-medium border border-amber-200 dark:border-amber-800/50 transition-colors">
        Chờ xử lý: @Model.PendingOrders
    </a>
    <a asp-action="Orders" asp-route-status="Processing" class="inline-flex items-center px-2.5 py-1 rounded bg-blue-50 dark:bg-blue-950/30 hover:bg-blue-100 dark:hover:bg-blue-900/40 text-blue-800 dark:text-blue-300 font-medium border border-blue-200 dark:border-blue-800/50 transition-colors">
        Đang xử lý: @Model.ProcessingOrders
    </a>
    <a asp-action="Orders" asp-route-status="Shipped" class="inline-flex items-center px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 font-medium border border-zinc-200 dark:border-zinc-700 transition-colors">
        Đang giao: @Model.ShippedOrders
    </a>
    <a asp-action="Orders" asp-route-status="Completed" class="inline-flex items-center px-2.5 py-1 rounded bg-emerald-50 dark:bg-emerald-950/30 hover:bg-emerald-100 dark:hover:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300 font-medium border border-emerald-200 dark:border-emerald-800/50 transition-colors">
        Hoàn thành: @Model.CompletedOrders
    </a>
    <a asp-action="Orders" asp-route-status="Cancelled" class="inline-flex items-center px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-600 dark:text-zinc-400 font-medium border border-zinc-200 dark:border-zinc-700 transition-colors">
        Đã hủy: @Model.CancelledOrders
    </a>
</div>

<!-- 2 Cột: Đơn hàng gần đây & Cảnh báo tồn kho -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">
    <!-- Đơn hàng gần đây (Cột 7) -->
    <div class="lg:col-span-7 bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden flex flex-col shadow-xs">
        <div class="px-5 py-4 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between">
            <h2 class="font-medium text-zinc-900 dark:text-zinc-100 text-xs uppercase tracking-wider flex items-center gap-1.5">
                <i class="fas fa-history text-zinc-400"></i> Đơn hàng gần đây
            </h2>
            <a asp-action="Orders" class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 font-medium transition-colors">
                Xem tất cả →
            </a>
        </div>

        <div class="flex-1 overflow-x-auto">
            @if (Model.RecentOrders.Any())
            {
                <table class="w-full text-left text-xs">
                    <thead class="bg-zinc-50/75 dark:bg-zinc-800/40 text-zinc-500 dark:text-zinc-400 uppercase tracking-wider text-[11px] border-b border-zinc-200 dark:border-zinc-800">
                        <tr>
                            <th class="py-2.5 px-4 font-medium">Mã đơn</th>
                            <th class="py-2.5 px-4 font-medium">Khách hàng</th>
                            <th class="py-2.5 px-4 font-medium text-right">Tổng tiền</th>
                            <th class="py-2.5 px-4 font-medium text-center">Trạng thái</th>
                            <th class="py-2.5 px-4 font-medium text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition-colors">
                                <td class="py-3 px-4 font-mono font-medium text-zinc-900 dark:text-zinc-100">
                                    #ORD-@order.Id.ToString("D5")
                                </td>
                                <td class="py-3 px-4">
                                    <div class="font-medium text-zinc-900 dark:text-zinc-100 truncate max-w-[140px]">
                                        @(order.User?.Email ?? $"User #{order.UserId}")
                                    </div>
                                    <div class="text-[10px] text-zinc-400">@order.OrderDate.ToString("dd/MM HH:mm")</div>
                                </td>
                                <td class="py-3 px-4 text-right font-medium text-zinc-900 dark:text-zinc-100">
                                    @order.TotalAmount.ToString("N0") đ
                                </td>
                                <td class="py-3 px-4 text-center">
                                    @switch (order.Status)
                                    {
                                        case ECommerce.Web.Models.Entities.Enums.OrderStatus.Pending:
                                            <span class="px-2 py-0.5 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-[11px] font-medium rounded border border-amber-200 dark:border-amber-800/50">Chờ duyệt</span>
                                            break;
                                        case ECommerce.Web.Models.Entities.Enums.OrderStatus.Processing:
                                            <span class="px-2 py-0.5 bg-blue-50 dark:bg-blue-950/30 text-blue-700 dark:text-blue-400 text-[11px] font-medium rounded border border-blue-200 dark:border-blue-800/50">Đang gói</span>
                                            break;
                                        case ECommerce.Web.Models.Entities.Enums.OrderStatus.Shipped:
                                            <span class="px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 text-[11px] font-medium rounded border border-zinc-200 dark:border-zinc-700">Đang giao</span>
                                            break;
                                        case ECommerce.Web.Models.Entities.Enums.OrderStatus.Completed:
                                            <span class="px-2 py-0.5 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 text-[11px] font-medium rounded border border-emerald-200 dark:border-emerald-800/50">Hoàn tất</span>
                                            break;
                                        case ECommerce.Web.Models.Entities.Enums.OrderStatus.Cancelled:
                                            <span class="px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 text-[11px] font-medium rounded border border-zinc-200 dark:border-zinc-700">Đã hủy</span>
                                            break;
                                    }
                                </td>
                                <td class="py-3 px-4 text-center">
                                    <a asp-action="OrderDetails" asp-route-id="@order.Id" class="inline-flex items-center px-2 py-1 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 rounded text-xs font-medium active:scale-[0.98] transition-all">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-8 text-center text-zinc-400 text-xs">
                    Chưa có đơn hàng nào phát sinh trong hệ thống.
                </div>
            }
        </div>
    </div>

    <!-- Cảnh báo tồn kho ít (Cột 5) -->
    <div class="lg:col-span-5 bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden flex flex-col shadow-xs">
        <div class="px-5 py-4 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between">
            <h2 class="font-medium text-rose-600 dark:text-rose-400 text-xs uppercase tracking-wider flex items-center gap-1.5">
                <i class="fas fa-exclamation-triangle"></i> Cảnh báo kho (&lt;10 sp)
            </h2>
            <a asp-action="Products" class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 font-medium transition-colors">
                Quản lý kho →
            </a>
        </div>

        <div class="flex-1 overflow-x-auto">
            @if (Model.LowStockProducts.Any())
            {
                <table class="w-full text-left text-xs">
                    <thead class="bg-zinc-50/75 dark:bg-zinc-800/40 text-zinc-500 dark:text-zinc-400 uppercase tracking-wider text-[11px] border-b border-zinc-200 dark:border-zinc-800">
                        <tr>
                            <th class="py-2.5 px-4 font-medium">Sản phẩm</th>
                            <th class="py-2.5 px-4 font-medium text-center">Tồn kho</th>
                            <th class="py-2.5 px-4 font-medium text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                        @foreach (var prod in Model.LowStockProducts)
                        {
                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-medium text-zinc-900 dark:text-zinc-100 truncate max-w-[150px]">@prod.Name</div>
                                    <div class="text-[10px] text-zinc-400">@(prod.Category?.Name ?? "N/A") · @prod.Price.ToString("N0") đ</div>
                                </td>
                                <td class="py-3 px-4 text-center">
                                    @if (prod.StockQuantity == 0)
                                    {
                                        <span class="px-2 py-0.5 bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-400 text-[11px] font-medium rounded border border-rose-200 dark:border-rose-900/50">Hết hàng</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-[11px] font-medium rounded border border-amber-200 dark:border-amber-800/50">Còn @prod.StockQuantity</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <a asp-action="ProductForm" asp-route-id="@prod.Id" class="inline-flex items-center px-2 py-1 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 rounded text-xs font-medium active:scale-[0.98] transition-all">
                                        Cập nhật
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-8 text-center text-zinc-400 text-xs">
                    <i class="fas fa-check-circle text-emerald-500 text-xl mb-1.5 block"></i>
                    Tất cả sản phẩm đều đảm bảo lượng tồn kho an toàn!
                </div>
            }
        </div>
    </div>
</div>

<!-- Lối tắt quản trị nhanh -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
    <a asp-action="ProductForm" class="p-4 bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors flex items-center space-x-3 group">
        <div class="w-9 h-9 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-sm">
            <i class="fas fa-plus"></i>
        </div>
        <div>
            <div class="font-medium text-zinc-900 dark:text-zinc-100 text-xs group-hover:text-zinc-600 dark:group-hover:text-zinc-300 transition-colors">Thêm sản phẩm mới</div>
            <div class="text-[11px] text-zinc-400">Mở rộng kho hàng</div>
        </div>
    </a>

    <a asp-action="CategoryForm" class="p-4 bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors flex items-center space-x-3 group">
        <div class="w-9 h-9 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-sm">
            <i class="fas fa-tag"></i>
        </div>
        <div>
            <div class="font-medium text-zinc-900 dark:text-zinc-100 text-xs group-hover:text-zinc-600 dark:group-hover:text-zinc-300 transition-colors">Tạo danh mục mới</div>
            <div class="text-[11px] text-zinc-400">Phân loại hàng hóa</div>
        </div>
    </a>

    <a asp-action="Orders" class="p-4 bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors flex items-center space-x-3 group">
        <div class="w-9 h-9 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-sm">
            <i class="fas fa-receipt"></i>
        </div>
        <div>
            <div class="font-medium text-zinc-900 dark:text-zinc-100 text-xs group-hover:text-zinc-600 dark:group-hover:text-zinc-300 transition-colors">Xử lý toàn bộ đơn</div>
            <div class="text-[11px] text-zinc-400">Duyệt & giao nhận</div>
        </div>
    </a>

    <a asp-action="Users" class="p-4 bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors flex items-center space-x-3 group">
        <div class="w-9 h-9 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-sm">
            <i class="fas fa-user-shield"></i>
        </div>
        <div>
            <div class="font-medium text-zinc-900 dark:text-zinc-100 text-xs group-hover:text-zinc-600 dark:group-hover:text-zinc-300 transition-colors">Phân quyền tài khoản</div>
            <div class="text-[11px] text-zinc-400">Quản trị viên & nhân viên</div>
        </div>
    </a>
</div>