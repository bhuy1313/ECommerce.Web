@model ECommerce.Web.Models.ViewModels.EditUserRolesViewModel
@{
    ViewData["Title"] = "Phân vai trò người dùng";
}

<div class="max-w-2xl mx-auto py-2">
    <!-- Breadcrumb -->
    <nav class="flex text-xs text-zinc-500 dark:text-zinc-400 mb-6 items-center gap-1.5" aria-label="Breadcrumb">
        <a asp-action="Index" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Dashboard</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <a asp-action="Users" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Người dùng</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <span class="text-zinc-900 dark:text-zinc-100 font-medium">Phân quyền</span>
    </nav>

    <div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 p-6 sm:p-8 shadow-xs">
        <div class="flex items-center space-x-3 pb-5 mb-5 border-b border-zinc-200 dark:border-zinc-800">
            <div class="w-9 h-9 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-sm border border-zinc-200 dark:border-zinc-700">
                <i class="fas fa-user-shield"></i>
            </div>
            <div>
                <h1 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
                    Phân vai trò & Quyền hạn
                </h1>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Thiết lập các vai trò quản trị hoặc mua sắm cho tài khoản</p>
            </div>
        </div>

        <div class="mb-5 p-3.5 bg-zinc-50 dark:bg-zinc-800/40 rounded-md border border-zinc-200 dark:border-zinc-800">
            <div class="text-[11px] text-zinc-400 font-medium">Tài khoản được phân quyền:</div>
            <div class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mt-0.5">@Model.Email</div>
            <div class="text-[10px] text-zinc-400 font-mono mt-0.5">User ID: @Model.UserId</div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-5 p-3 bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/40 text-rose-700 dark:text-rose-300 rounded-md text-xs" role="alert">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form method="post" asp-action="EditUserRoles" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Email" />

            <div>
                <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-2">Chọn các vai trò phân bổ:</label>
                <div class="space-y-2.5">
                    @for (int i = 0; i < Model.Roles.Count; i++)
                    {
                        <input type="hidden" asp-for="Roles[i].RoleName" />
                        <label for="role_@Model.Roles[i].RoleName" class="flex items-start p-3 border border-zinc-200 dark:border-zinc-800 rounded-md bg-white dark:bg-zinc-900 hover:bg-zinc-50 dark:hover:bg-zinc-800/40 cursor-pointer transition-colors">
                            <input class="mt-0.5 h-4 w-4 rounded border-zinc-300 dark:border-zinc-700 text-zinc-900 accent-zinc-900 dark:accent-zinc-100 cursor-pointer mr-3" type="checkbox" asp-for="Roles[i].IsSelected" id="role_@Model.Roles[i].RoleName" />
                            <div class="flex-1 text-xs">
                                <div class="font-medium flex items-center">
                                    @if (Model.Roles[i].RoleName == ECommerce.Web.Models.Constants.AppRoles.Admin)
                                    {
                                        <span class="text-rose-700 dark:text-rose-400"><i class="fas fa-crown mr-1 text-[10px]"></i> @Model.Roles[i].RoleName (Toàn quyền hệ thống)</span>
                                    }
                                    else if (Model.Roles[i].RoleName == ECommerce.Web.Models.Constants.AppRoles.StoreOperator)
                                    {
                                        <span class="text-amber-700 dark:text-amber-400"><i class="fas fa-tools mr-1 text-[10px]"></i> @Model.Roles[i].RoleName (Vận hành cửa hàng)</span>
                                    }
                                    else
                                    {
                                        <span class="text-zinc-700 dark:text-zinc-300"><i class="far fa-user mr-1 text-[10px]"></i> @Model.Roles[i].RoleName (Khách hàng thông thường)</span>
                                    }
                                </div>
                                <p class="text-[11px] text-zinc-400 mt-0.5">
                                    @if (Model.Roles[i].RoleName == ECommerce.Web.Models.Constants.AppRoles.Admin)
                                    {
                                        <span>Toàn quyền Dashboard, Sản phẩm, Danh mục, Đơn hàng, Phân quyền.</span>
                                    }
                                    else if (Model.Roles[i].RoleName == ECommerce.Web.Models.Constants.AppRoles.StoreOperator)
                                    {
                                        <span>Quản lý đơn hàng, theo dõi kho và sản phẩm.</span>
                                    }
                                    else
                                    {
                                        <span>Mua sắm, quản lý giỏ hàng và theo dõi đơn mua cá nhân.</span>
                                    }
                                </p>
                            </div>
                        </label>
                    }
                </div>
            </div>

            <div class="flex items-center justify-between pt-5 border-t border-zinc-200 dark:border-zinc-800">
                <a asp-action="Users" class="px-3.5 py-1.5 rounded-md border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800 text-xs font-medium active:scale-[0.98] transition-all">
                    Hủy bỏ
                </a>
                <button type="submit" class="px-4 py-2 rounded-md bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 text-xs font-medium active:scale-[0.98] transition-all shadow-sm">
                    Lưu thay đổi phân quyền
                </button>
            </div>
        </form>
    </div>
</div>