@model IEnumerable<ECommerce.Web.Models.Entities.Product>
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    var categories = ViewBag.Categories as IEnumerable<ECommerce.Web.Models.Entities.Category> ?? Enumerable.Empty<ECommerce.Web.Models.Entities.Category>();
    int? selectedCategory = ViewBag.SelectedCategoryId;
    string? searchQuery = ViewBag.SearchQuery;
}

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h1 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <i class="fas fa-boxes text-zinc-400 text-base"></i>Quản lý Sản phẩm
        </h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Quản lý kho hàng, đơn giá, số lượng tồn và trạng thái hiển thị</p>
    </div>
    <a asp-action="CreateProduct" class="inline-flex items-center px-3 py-1.5 rounded-md bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 text-xs font-medium active:scale-[0.98] transition-all w-max shadow-sm">
        <i class="fas fa-plus mr-1.5 text-xs"></i> Thêm sản phẩm mới
    </a>
</div>

<!-- Thanh tìm kiếm & lọc Admin -->
<div class="bg-white dark:bg-zinc-900 p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 mb-5 shadow-xs">
    <form method="get" asp-action="Products" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
        <div class="md:col-span-6 relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-400">
                <i class="fas fa-search text-xs"></i>
            </div>
            <input type="text" name="search" value="@searchQuery" class="w-full pl-9 pr-3 py-1.5 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" placeholder="Tìm theo tên hoặc mô tả sản phẩm..." />
        </div>
        <div class="md:col-span-4">
            <select name="categoryId" class="w-full py-1.5 px-3 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100">
                <option value="">-- Tất cả danh mục --</option>
                @foreach (var cat in categories)
                {
                    if (selectedCategory == cat.Id)
                    {
                        <option value="@cat.Id" selected>@cat.Name</option>
                    }
                    else
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>
        </div>
        <div class="md:col-span-2 flex items-center gap-1.5">
            <button type="submit" class="flex-1 py-1.5 px-3 bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 rounded-md text-xs font-medium active:scale-[0.98] transition-all">
                Lọc
            </button>
            @if (!string.IsNullOrWhiteSpace(searchQuery) || selectedCategory.HasValue)
            {
                <a asp-action="Products" class="py-1.5 px-2.5 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-600 dark:text-zinc-400 rounded-md text-xs font-medium transition-colors" title="Xóa bộ lọc">
                    ✕
                </a>
            }
        </div>
    </form>
</div>

<!-- Bảng danh sách sản phẩm -->
<div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden shadow-xs">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
            <thead class="bg-zinc-50/75 dark:bg-zinc-800/40 text-zinc-500 dark:text-zinc-400 uppercase tracking-wider text-[11px] border-b border-zinc-200 dark:border-zinc-800">
                <tr>
                    <th class="py-2.5 px-4 font-medium w-16">ID</th>
                    <th class="py-2.5 px-4 font-medium text-center w-16">Ảnh</th>
                    <th class="py-2.5 px-4 font-medium">Tên sản phẩm</th>
                    <th class="py-2.5 px-4 font-medium">Danh mục</th>
                    <th class="py-2.5 px-4 font-medium text-right">Đơn giá</th>
                    <th class="py-2.5 px-4 font-medium text-center">Tồn kho</th>
                    <th class="py-2.5 px-4 font-medium text-center">Trạng thái</th>
                    <th class="py-2.5 px-4 font-medium text-right">Hành động</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="py-10 text-center text-zinc-400">
                            <i class="fas fa-box-open text-2xl mb-2 block"></i>
                            Không tìm thấy sản phẩm nào phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition-colors">
                            <td class="py-3 px-4 font-mono font-medium text-zinc-400 text-xs">
                                #@product.Id
                            </td>
                            <td class="py-3 px-4 text-center">
                                <img src="@ProductImage.Resolve(product.ImageUrl)" onerror="this.onerror=null;this.src='@ProductImage.Placeholder';" alt="Ảnh sản phẩm @product.Name" class="w-9 h-9 rounded border border-zinc-200 dark:border-zinc-700 object-contain bg-white dark:bg-zinc-800 p-0.5 mx-auto" />
                            </td>
                            <td class="py-3 px-4">
                                <div class="font-medium text-zinc-900 dark:text-zinc-100 text-xs">@product.Name</div>
                                <div class="text-[11px] text-zinc-400 truncate max-w-xs mt-0.5">
                                    @(string.IsNullOrWhiteSpace(product.Description) ? "Không có mô tả chi tiết" : product.Description)
                                </div>
                            </td>
                            <td class="py-3 px-4">
                                <span class="inline-block px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-[11px] font-medium rounded border border-zinc-200 dark:border-zinc-700">
                                    @product.Category?.Name
                                </span>
                            </td>
                            <td class="py-3 px-4 text-right font-medium text-zinc-900 dark:text-zinc-100 text-xs">
                                @product.Price.ToString("N0") đ
                            </td>
                            <td class="py-3 px-4 text-center">
                                @if (product.StockQuantity <= 0)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-400 text-[11px] font-medium rounded border border-rose-200 dark:border-rose-900/50">
                                        Hết hàng (0)
                                    </span>
                                }
                                else if (product.StockQuantity < ECommerce.Web.Models.Constants.AppConstants.LowStockThreshold)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-[11px] font-medium rounded border border-amber-200 dark:border-amber-800/50">
                                        Còn @product.StockQuantity
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-[11px] font-medium rounded border border-zinc-200 dark:border-zinc-700">
                                        @product.StockQuantity sp
                                    </span>
                                }
                            </td>
                            <td class="py-3 px-4 text-center">
                                @if (product.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 text-[11px] font-medium rounded border border-emerald-200 dark:border-emerald-800/50">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span> Đang bán
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 text-[11px] font-medium rounded border border-zinc-200 dark:border-zinc-700">
                                        Ẩn
                                    </span>
                                }
                            </td>
                            <td class="py-3 px-4 text-right">
                                <div class="inline-flex items-center gap-1.5">
                                    <a asp-action="EditProduct" asp-route-id="@product.Id" class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 text-xs font-medium active:scale-[0.98] transition-all">
                                        <i class="fas fa-edit mr-1 text-[10px]"></i> Sửa
                                    </a>
                                    <form asp-action="ToggleProductStatus" asp-route-id="@product.Id" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="px-2.5 py-1 rounded text-xs font-medium active:scale-[0.98] transition-all @(product.IsActive ? "bg-amber-50 dark:bg-amber-950/30 hover:bg-amber-100 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800/50" : "bg-emerald-50 dark:bg-emerald-950/30 hover:bg-emerald-100 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50")" title="@(product.IsActive ? "Ẩn sản phẩm" : "Mở bán lại")">
                                            @(product.IsActive ? "Lưu kho" : "Kích hoạt")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>