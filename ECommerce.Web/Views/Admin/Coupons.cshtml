@model IReadOnlyList<ECommerce.Web.Models.Entities.Coupon>
@using ECommerce.Web.Models.Entities.Enums
@{
    ViewData["Title"] = "Quản lý mã giảm giá";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h1 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <i class="fas fa-ticket-alt text-zinc-400 text-base"></i>Mã giảm giá
        </h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Tạo và quản lý mã ưu đãi áp dụng tại bước thanh toán</p>
    </div>
    <div class="flex items-center gap-2">
        <a asp-action="Index" class="inline-flex items-center px-3 py-1.5 rounded-md bg-white dark:bg-zinc-900 hover:bg-zinc-50 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-medium active:scale-[0.98] transition-all">
            <i class="fas fa-arrow-left mr-1.5 text-xs"></i> Dashboard
        </a>
        <a asp-action="CreateCoupon" class="inline-flex items-center px-3 py-1.5 rounded-md bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 text-xs font-medium active:scale-[0.98] transition-all shadow-sm">
            <i class="fas fa-plus mr-1 text-xs"></i> Thêm mã
        </a>
    </div>
</div>

<div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden shadow-xs">
    @if (Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-zinc-50/75 dark:bg-zinc-800/40 text-zinc-500 dark:text-zinc-400 uppercase tracking-wider text-[11px] border-b border-zinc-200 dark:border-zinc-800">
                    <tr>
                        <th class="py-2.5 px-4 font-medium">Mã</th>
                        <th class="py-2.5 px-4 font-medium">Loại</th>
                        <th class="py-2.5 px-4 font-medium text-right">Giá trị</th>
                        <th class="py-2.5 px-4 font-medium text-right">Đơn tối thiểu</th>
                        <th class="py-2.5 px-4 font-medium text-center">Đã dùng</th>
                        <th class="py-2.5 px-4 font-medium">Hiệu lực</th>
                        <th class="py-2.5 px-4 font-medium text-center">Trạng thái</th>
                        <th class="py-2.5 px-4 font-medium text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                    @foreach (var coupon in Model)
                    {
                        var isExpired = coupon.EndsOn < today;
                        var isNotStarted = coupon.StartsOn > today;
                        var isDepleted = coupon.UsedCount >= coupon.UsageLimit;

                        <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition-colors">
                            <td class="py-3 px-4 font-mono font-medium text-zinc-900 dark:text-zinc-100 text-xs">@coupon.Code</td>
                            <td class="py-3 px-4 text-xs text-zinc-500 dark:text-zinc-400">
                                @(coupon.DiscountType == DiscountType.Percentage ? "Phần trăm" : "Số tiền")
                            </td>
                            <td class="py-3 px-4 text-right font-medium text-zinc-900 dark:text-zinc-100 text-xs">
                                @(coupon.DiscountType == DiscountType.Percentage
                                    ? $"{coupon.Value:N0}%"
                                    : $"{coupon.Value:N0} đ")
                            </td>
                            <td class="py-3 px-4 text-right text-xs text-zinc-600 dark:text-zinc-400">@coupon.MinOrderAmount.ToString("N0") đ</td>
                            <td class="py-3 px-4 text-center text-xs text-zinc-600 dark:text-zinc-400">@coupon.UsedCount / @coupon.UsageLimit</td>
                            <td class="py-3 px-4 text-xs text-zinc-500 dark:text-zinc-400">
                                @coupon.StartsOn.ToString("dd/MM/yyyy") – @coupon.EndsOn.ToString("dd/MM/yyyy")
                            </td>
                            <td class="py-3 px-4 text-center">
                                @if (!coupon.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 text-[11px] font-medium rounded border border-zinc-200 dark:border-zinc-700">Đã tắt</span>
                                }
                                else if (isExpired)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-400 text-[11px] font-medium rounded border border-rose-200 dark:border-rose-900/50">Hết hạn</span>
                                }
                                else if (isDepleted)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-[11px] font-medium rounded border border-amber-200 dark:border-amber-800/50">Hết lượt</span>
                                }
                                else if (isNotStarted)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-blue-50 dark:bg-blue-950/30 text-blue-700 dark:text-blue-400 text-[11px] font-medium rounded border border-blue-200 dark:border-blue-800/50">Chưa bắt đầu</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 text-[11px] font-medium rounded border border-emerald-200 dark:border-emerald-800/50">Đang chạy</span>
                                }
                            </td>
                            <td class="py-3 px-4 text-right">
                                <div class="inline-flex items-center gap-1.5">
                                    <a asp-action="EditCoupon" asp-route-id="@coupon.Id" class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 text-xs font-medium active:scale-[0.98] transition-all">
                                        <i class="fas fa-edit mr-1 text-[10px]"></i> Sửa
                                    </a>
                                    <form asp-action="ToggleCouponStatus" asp-route-id="@coupon.Id" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="px-2.5 py-1 rounded text-xs font-medium active:scale-[0.98] transition-all @(coupon.IsActive ? "bg-amber-50 dark:bg-amber-950/30 hover:bg-amber-100 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800/50" : "bg-emerald-50 dark:bg-emerald-950/30 hover:bg-emerald-100 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50")" title="@(coupon.IsActive ? "Tắt mã" : "Bật mã")">
                                            @(coupon.IsActive ? "Tắt" : "Bật")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-10 text-center text-zinc-400 text-xs">
            <i class="fas fa-ticket-alt text-2xl mb-2 block"></i>
            Chưa có mã giảm giá nào được tạo.
        </div>
    }
</div>