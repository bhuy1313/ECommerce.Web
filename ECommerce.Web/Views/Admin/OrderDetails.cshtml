@model ECommerce.Web.Models.Entities.Order
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Id} (Admin)";
}

<div class="max-w-5xl mx-auto py-2">
    <!-- Breadcrumb -->
    <nav class="flex text-xs text-zinc-500 dark:text-zinc-400 mb-6 items-center gap-1.5" aria-label="Breadcrumb">
        <a asp-action="Index" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Dashboard</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <a asp-action="Orders" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Đơn hàng</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <span class="text-zinc-900 dark:text-zinc-100 font-medium">Đơn #@Model.Id</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Thông tin chi tiết đơn hàng (Cột 8) -->
        <div class="lg:col-span-8 bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 p-6 shadow-xs">
            <div class="flex flex-wrap justify-between items-start gap-4 pb-5 mb-5 border-b border-zinc-200 dark:border-zinc-800">
                <div>
                    <h1 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
                        Đơn hàng #ORD-@Model.Id.ToString("D5")
                    </h1>
                    <div class="text-xs text-zinc-500 dark:text-zinc-400 mt-1 space-y-0.5">
                        <p><i class="far fa-user mr-1 text-zinc-400"></i> Khách hàng: <strong class="text-zinc-700 dark:text-zinc-300">@(Model.User?.Email ?? Model.UserId)</strong></p>
                        <p><i class="far fa-clock mr-1 text-zinc-400"></i> Thời gian: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</p>
                    </div>
                </div>
            </div>

            <!-- Thông tin nhận hàng -->
            <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3">Thông tin nhận hàng</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-xs border border-zinc-200 dark:border-zinc-800 rounded-md mb-6 p-4 bg-zinc-50/50 dark:bg-zinc-850">
                <div>
                    <span class="block text-[11px] text-zinc-400 mb-0.5">Người nhận</span>
                    <span class="font-medium text-zinc-900 dark:text-zinc-100">@Model.RecipientName</span>
                </div>
                <div>
                    <span class="block text-[11px] text-zinc-400 mb-0.5">Số điện thoại</span>
                    <span class="font-medium text-zinc-900 dark:text-zinc-100">@Model.RecipientPhone</span>
                </div>
                <div class="sm:col-span-2">
                    <span class="block text-[11px] text-zinc-400 mb-0.5">Địa chỉ giao hàng</span>
                    <span class="font-medium text-zinc-900 dark:text-zinc-100 whitespace-pre-line">@Model.ShippingAddress</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="sm:col-span-2">
                        <span class="block text-[11px] text-zinc-400 mb-0.5">Ghi chú</span>
                        <span class="text-zinc-600 dark:text-zinc-400 whitespace-pre-line">@Model.Note</span>
                    </div>
                }
            </div>

            <!-- Bảng chi tiết sản phẩm -->
            <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3">Các mặt hàng trong đơn</h2>
            <div class="overflow-x-auto border border-zinc-200 dark:border-zinc-800 rounded-md mb-6">
                <table class="w-full text-left text-xs">
                    <thead class="bg-zinc-50/75 dark:bg-zinc-800/40 text-zinc-500 dark:text-zinc-400 uppercase tracking-wider text-[11px] border-b border-zinc-200 dark:border-zinc-800">
                        <tr>
                            <th class="py-2.5 px-4 font-medium">Sản phẩm</th>
                            <th class="py-2.5 px-4 font-medium text-center">Số lượng</th>
                            <th class="py-2.5 px-4 font-medium text-right">Đơn giá</th>
                            <th class="py-2.5 px-4 font-medium text-right">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                        @foreach (var item in Model.Items)
                        {
                            var lineTotal = item.Quantity * item.UnitPrice;
                            <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30">
                                <td class="py-3 px-4">
                                    <div class="font-medium text-zinc-900 dark:text-zinc-100">@item.ProductName</div>
                                    <div class="text-[10px] text-zinc-400 font-mono">#PRD-@item.ProductId</div>
                                </td>
                                <td class="py-3 px-4 text-center text-zinc-600 dark:text-zinc-400">
                                    @item.Quantity
                                </td>
                                <td class="py-3 px-4 text-right text-zinc-600 dark:text-zinc-400">
                                    @item.UnitPrice.ToString("N0") đ
                                </td>
                                <td class="py-3 px-4 text-right font-medium text-zinc-900 dark:text-zinc-100">
                                    @lineTotal.ToString("N0") đ
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-zinc-50/60 dark:bg-zinc-800/40 border-t border-zinc-200 dark:border-zinc-800 text-xs">
                        @if (Model.ShippingFee > 0)
                        {
                            <tr>
                                <td colspan="3" class="py-2 px-4 text-right text-zinc-500 dark:text-zinc-400">Phí vận chuyển:</td>
                                <td class="py-2 px-4 text-right font-medium text-zinc-900 dark:text-zinc-100">@Model.ShippingFee.ToString("N0") đ</td>
                            </tr>
                        }
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr>
                                <td colspan="3" class="py-2 px-4 text-right text-emerald-600 dark:text-emerald-400">Giảm giá (@Model.CouponCode):</td>
                                <td class="py-2 px-4 text-right font-medium text-emerald-600 dark:text-emerald-400">-@Model.DiscountAmount.ToString("N0") đ</td>
                            </tr>
                        }
                        @if (Model.TaxAmount > 0)
                        {
                            <tr>
                                <td colspan="3" class="py-2 px-4 text-right text-zinc-500 dark:text-zinc-400">Thuế VAT:</td>
                                <td class="py-2 px-4 text-right font-medium text-zinc-900 dark:text-zinc-100">@Model.TaxAmount.ToString("N0") đ</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="3" class="py-3 px-4 text-right font-semibold text-zinc-900 dark:text-zinc-100 border-t border-zinc-200 dark:border-zinc-800">Tổng thanh toán:</td>
                            <td class="py-3 px-4 text-right font-bold text-zinc-900 dark:text-zinc-100 text-base border-t border-zinc-200 dark:border-zinc-800">@Model.TotalAmount.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="pt-4 border-t border-zinc-200 dark:border-zinc-800">
                <a asp-action="Orders" class="inline-flex items-center text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
                    <i class="fas fa-arrow-left mr-1.5 text-xs"></i> Trở về danh sách đơn hàng
                </a>
            </div>
        </div>

        <!-- Bảng điều khiển trạng thái (Workflow Control - Cột 4) -->
        <div class="lg:col-span-4 space-y-4">
            <!-- Cập nhật trạng thái đơn -->
            <div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 p-5 shadow-xs">
                <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3 flex items-center gap-1.5">
                    <i class="fas fa-stream text-zinc-400"></i>Trạng thái đơn hàng
                </h2>

                <div class="mb-3.5">
                    <span class="text-[11px] text-zinc-400 block mb-1">Hiện tại:</span>
                    @switch (Model.Status)
                    {
                        case ECommerce.Web.Models.Entities.Enums.OrderStatus.Pending:
                            <span class="px-2.5 py-1 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-xs font-medium rounded border border-amber-200 dark:border-amber-800/50">Chờ xử lý (Pending)</span>
                            break;
                        case ECommerce.Web.Models.Entities.Enums.OrderStatus.Processing:
                            <span class="px-2.5 py-1 bg-blue-50 dark:bg-blue-950/30 text-blue-700 dark:text-blue-400 text-xs font-medium rounded border border-blue-200 dark:border-blue-800/50">Đang gói (Processing)</span>
                            break;
                        case ECommerce.Web.Models.Entities.Enums.OrderStatus.Shipped:
                            <span class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 text-xs font-medium rounded border border-zinc-200 dark:border-zinc-700">Đang giao (Shipped)</span>
                            break;
                        case ECommerce.Web.Models.Entities.Enums.OrderStatus.Completed:
                            <span class="px-2.5 py-1 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 text-xs font-medium rounded border border-emerald-200 dark:border-emerald-800/50">Hoàn tất (Completed)</span>
                            break;
                        case ECommerce.Web.Models.Entities.Enums.OrderStatus.Cancelled:
                            <span class="px-2.5 py-1 bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-400 text-xs font-medium rounded border border-rose-200 dark:border-rose-900/50">Đã hủy (Cancelled)</span>
                            break;
                    }
                </div>

                <form asp-action="UpdateOrderStatus" method="post" class="space-y-3 pt-3 border-t border-zinc-200 dark:border-zinc-800">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.Id" />

                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300">Chuyển sang trạng thái:</label>
                    <select name="status" class="w-full py-2 px-3 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100">
                        @foreach (ECommerce.Web.Models.Entities.Enums.OrderStatus st in Enum.GetValues(typeof(ECommerce.Web.Models.Entities.Enums.OrderStatus)))
                        {
                            if (Model.Status == st)
                            {
                                <option value="@st" selected>@st (Hiện tại)</option>
                            }
                            else
                            {
                                <option value="@st">@st</option>
                            }
                        }
                    </select>

                    <button type="submit" class="w-full py-2 px-3 bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 rounded-md text-xs font-medium active:scale-[0.98] transition-all">
                        Cập nhật trạng thái
                    </button>
                </form>
            </div>

            <!-- Cập nhật thanh toán -->
            <div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 p-5 shadow-xs">
                <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3 flex items-center gap-1.5">
                    <i class="fas fa-credit-card text-zinc-400"></i>Thanh toán
                </h2>

                <div class="mb-3.5">
                    <span class="text-[11px] text-zinc-400 block mb-1">Hiện tại:</span>
                    @switch (Model.PaymentStatus)
                    {
                        case ECommerce.Web.Models.Entities.Enums.PaymentStatus.Pending:
                            <span class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 text-xs font-medium rounded border border-zinc-200 dark:border-zinc-700">Chưa thanh toán (Pending)</span>
                            break;
                        case ECommerce.Web.Models.Entities.Enums.PaymentStatus.Paid:
                            <span class="px-2.5 py-1 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 text-xs font-medium rounded border border-emerald-200 dark:border-emerald-800/50">Đã thanh toán (Paid)</span>
                            break;
                        case ECommerce.Web.Models.Entities.Enums.PaymentStatus.RefundPending:
                            <span class="px-2.5 py-1 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-xs font-medium rounded border border-amber-200 dark:border-amber-800/50">Chờ hoàn tiền (RefundPending)</span>
                            break;
                        case ECommerce.Web.Models.Entities.Enums.PaymentStatus.Refunded:
                            <span class="px-2.5 py-1 bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-400 text-xs font-medium rounded border border-rose-200 dark:border-rose-900/50">Đã hoàn tiền (Refunded)</span>
                            break;
                    }
                </div>

                @if (User.IsInRole(ECommerce.Web.Models.Constants.AppRoles.Admin))
                {
                <form asp-action="UpdatePaymentStatus" method="post" class="space-y-3 pt-3 border-t border-zinc-200 dark:border-zinc-800">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.Id" />

                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300">Đổi trạng thái thanh toán:</label>
                    <select name="status" class="w-full py-2 px-3 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100">
                        @foreach (ECommerce.Web.Models.Entities.Enums.PaymentStatus st in Enum.GetValues(typeof(ECommerce.Web.Models.Entities.Enums.PaymentStatus)))
                        {
                            if (Model.PaymentStatus == st)
                            {
                                <option value="@st" selected>@st (Hiện tại)</option>
                            }
                            else
                            {
                                <option value="@st">@st</option>
                            }
                        }
                    </select>

                    <button type="submit" class="w-full py-2 px-3 bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 rounded-md text-xs font-medium active:scale-[0.98] transition-all">
                        Xác nhận thanh toán
                    </button>
                </form>
                }
            </div>
        </div>
    </div>
</div>