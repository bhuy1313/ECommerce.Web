@model IEnumerable<ECommerce.Web.Models.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "Quản lý Người dùng & Phân vai";
}

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-gray-100 flex items-center">
            <i class="fas fa-users-cog text-primary dark:text-indigo-300 mr-3 text-2xl"></i>Quản lý Người dùng
        </h1>
        <p class="text-sm text-slate-500 dark:text-gray-400 mt-1">Danh sách tài khoản trong hệ thống, theo dõi số đơn và phân quyền quản trị</p>
    </div>
    <span class="inline-flex items-center px-4 py-2 bg-indigo-50 dark:bg-indigo-900/40 text-primary dark:text-indigo-300 border border-indigo-100 rounded-xl text-xs font-bold w-max">
        Tổng số: @Model.Count() tài khoản
    </span>
</div>

<!-- Bảng người dùng -->
<div class="bg-white dark:bg-gray-900 rounded-3xl shadow-sm border border-slate-100 dark:border-gray-800 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 dark:bg-gray-800 text-slate-400 text-xs uppercase tracking-wider border-b border-slate-100 dark:border-gray-800">
                <tr>
                    <th class="py-4 px-6 font-semibold">Email / Tài khoản</th>
                    <th class="py-4 px-6 font-semibold">Vai trò được gán (Roles)</th>
                    <th class="py-4 px-6 font-semibold text-center">Đơn đã đặt</th>
                    <th class="py-4 px-6 font-semibold text-right">Hành động</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-gray-800">
                @foreach (var user in Model)
                {
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-gray-800/50 transition-colors">
                        <td class="py-4 px-6">
                            <div class="flex items-center space-x-3">
                                <div class="w-9 h-9 rounded-full bg-slate-100 dark:bg-gray-800 text-slate-600 dark:text-gray-400 font-bold flex items-center justify-center text-xs border border-slate-200 dark:border-gray-700">
                                    @(user.Email.Length > 0 ? user.Email.Substring(0, 1).ToUpper() : "U")
                                </div>
                                <div>
                                    <div class="font-bold text-slate-900 dark:text-gray-100 text-sm flex items-center">
                                        @user.Email
                                        @if (user.IsCurrentAdmin)
                                        {
                                            <span class="ml-2 px-2 py-0.5 bg-primary/10 text-primary dark:text-indigo-300 border border-primary/20 rounded-md text-[10px] font-bold">
                                                Bạn (Đang đăng nhập)
                                            </span>
                                        }
                                    </div>
                                    <div class="text-[11px] text-slate-400 font-mono">ID: @user.Id</div>
                                </div>
                            </div>
                        </td>
                        <td class="py-4 px-6">
                            <div class="flex flex-wrap gap-1.5">
                                @if (user.Roles.Any())
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        @if (role == ECommerce.Web.Models.Constants.AppRoles.Admin)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 bg-rose-50 text-rose-700 text-xs font-bold rounded-lg border border-rose-200">
                                                <i class="fas fa-crown mr-1.5 text-rose-500 text-[10px]"></i> @role
                                            </span>
                                        }
                                        else if (role == ECommerce.Web.Models.Constants.AppRoles.StoreOperator)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 bg-amber-50 text-amber-700 text-xs font-bold rounded-lg border border-amber-200">
                                                <i class="fas fa-tools mr-1.5 text-amber-500 text-[10px]"></i> @role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 bg-slate-100 dark:bg-gray-800 text-slate-600 dark:text-gray-400 text-xs font-semibold rounded-lg border border-slate-200 dark:border-gray-700">
                                                <i class="far fa-user mr-1.5 text-slate-400 text-[10px]"></i> @role
                                            </span>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400 italic">Chưa gán vai trò</span>
                                }
                            </div>
                        </td>
                        <td class="py-4 px-6 text-center">
                            <span class="inline-block px-3 py-1 bg-slate-100 dark:bg-gray-800 text-slate-700 dark:text-gray-300 text-xs font-semibold rounded-full">
                                @user.OrderCount đơn
                            </span>
                        </td>
                        <td class="py-4 px-6 text-right">
                            <a asp-action="EditUserRoles" asp-route-id="@user.Id" class="inline-flex items-center px-3 py-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-900/40 hover:bg-primary text-primary dark:text-indigo-300 hover:text-white text-xs font-semibold transition-colors">
                                <i class="fas fa-shield-alt mr-1.5"></i> Phân vai trò
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
