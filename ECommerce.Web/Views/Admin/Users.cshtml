@model IEnumerable<ECommerce.Web.Models.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "Quản lý Người dùng & Phân vai";
}

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
        <h1 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <i class="fas fa-users-cog text-zinc-400 text-base"></i>Quản lý Người dùng
        </h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Danh sách tài khoản trong hệ thống, theo dõi số đơn và phân quyền quản trị</p>
    </div>
    <span class="inline-flex items-center px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 rounded-md text-xs font-medium w-max">
        Tổng số: @Model.Count() tài khoản
    </span>
</div>

<!-- Bảng người dùng -->
<div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden shadow-xs">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
            <thead class="bg-zinc-50/75 dark:bg-zinc-800/40 text-zinc-500 dark:text-zinc-400 uppercase tracking-wider text-[11px] border-b border-zinc-200 dark:border-zinc-800">
                <tr>
                    <th class="py-2.5 px-4 font-medium">Email / Tài khoản</th>
                    <th class="py-2.5 px-4 font-medium">Vai trò được gán (Roles)</th>
                    <th class="py-2.5 px-4 font-medium text-center">Đơn đã đặt</th>
                    <th class="py-2.5 px-4 font-medium text-right">Hành động</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                @foreach (var user in Model)
                {
                    <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition-colors">
                        <td class="py-3 px-4">
                            <div class="flex items-center space-x-2.5">
                                <div class="w-7 h-7 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-semibold flex items-center justify-center text-xs border border-zinc-200 dark:border-zinc-700">
                                    @(user.Email.Length > 0 ? user.Email.Substring(0, 1).ToUpper() : "U")
                                </div>
                                <div>
                                    <div class="font-medium text-zinc-900 dark:text-zinc-100 text-xs flex items-center">
                                        @user.Email
                                        @if (user.IsCurrentAdmin)
                                        {
                                            <span class="ml-2 px-1.5 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700 rounded text-[10px] font-medium">
                                                Bạn (Hiện tại)
                                            </span>
                                        }
                                    </div>
                                    <div class="text-[10px] text-zinc-400 font-mono">ID: @user.Id</div>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 px-4">
                            <div class="flex flex-wrap gap-1">
                                @if (user.Roles.Any())
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        @if (role == ECommerce.Web.Models.Constants.AppRoles.Admin)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-400 text-[11px] font-medium rounded border border-rose-200 dark:border-rose-900/50">
                                                <i class="fas fa-crown mr-1 text-[9px]"></i> @role
                                            </span>
                                        }
                                        else if (role == ECommerce.Web.Models.Constants.AppRoles.StoreOperator)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-[11px] font-medium rounded border border-amber-200 dark:border-amber-800/50">
                                                <i class="fas fa-tools mr-1 text-[9px]"></i> @role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 text-[11px] font-medium rounded border border-zinc-200 dark:border-zinc-700">
                                                <i class="far fa-user mr-1 text-[9px]"></i> @role
                                            </span>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-xs text-zinc-400 italic">Chưa gán vai trò</span>
                                }
                            </div>
                        </td>
                        <td class="py-3 px-4 text-center">
                            <span class="inline-block px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-[11px] font-medium rounded border border-zinc-200 dark:border-zinc-700">
                                @user.OrderCount đơn
                            </span>
                        </td>
                        <td class="py-3 px-4 text-right">
                            <a asp-action="EditUserRoles" asp-route-id="@user.Id" class="inline-flex items-center px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 text-xs font-medium active:scale-[0.98] transition-all">
                                <i class="fas fa-shield-alt mr-1 text-[10px]"></i> Phân vai
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>