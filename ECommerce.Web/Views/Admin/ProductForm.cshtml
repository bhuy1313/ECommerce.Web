@model ECommerce.Web.Models.ViewModels.ProductFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Cập nhật sản phẩm" : "Thêm sản phẩm mới";
}

<div class="max-w-3xl mx-auto py-4">
    <!-- Breadcrumb -->
    <nav class="flex text-xs text-slate-400 mb-6 items-center">
        <a asp-action="Index" class="hover:text-primary dark:hover:text-indigo-300 transition-colors">Dashboard</a>
        <span class="mx-2 text-slate-300">/</span>
        <a asp-action="Products" class="hover:text-primary dark:hover:text-indigo-300 transition-colors">Sản phẩm</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700 dark:text-gray-300 font-medium">@(isEdit ? $"Cập nhật #{Model.Id}" : "Thêm mới")</span>
    </nav>

    <div class="bg-white dark:bg-gray-900 rounded-3xl shadow-sm border border-slate-100 dark:border-gray-800 p-6 sm:p-10">
        <div class="flex items-center space-x-3 pb-6 mb-6 border-b border-slate-100 dark:border-gray-800">
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-900/40 text-primary dark:text-indigo-300 flex items-center justify-center text-xl">
                <i class="fas @(isEdit ? "fa-edit" : "fa-plus")"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-gray-100">
                    @(isEdit ? $"Cập nhật sản phẩm: {Model.Name}" : "Tạo sản phẩm mới")
                </h1>
                <p class="text-xs text-slate-400 mt-0.5">Điền đầy đủ các thông số chi tiết để sản phẩm sẵn sàng mở bán</p>
            </div>
        </div>

        <form asp-action="@(isEdit ? "EditProduct" : "CreateProduct")" method="post" novalidate class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="p-4 bg-rose-50 border border-rose-200 text-rose-700 rounded-2xl text-xs" role="alert"></div>

            <div class="grid grid-cols-1 sm:grid-cols-12 gap-6">
                <div class="sm:col-span-8">
                    <label asp-for="Name" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                    <input asp-for="Name" class="w-full px-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none transition-all" placeholder="Ví dụ: Bàn phím cơ Keychron K8 Pro" />
                    <span asp-validation-for="Name" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div class="sm:col-span-4">
                    <label asp-for="CategoryId" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                    <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="w-full px-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none bg-white dark:bg-gray-900 transition-all">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <label asp-for="Price" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-bold">đ</span>
                        <input asp-for="Price" type="number" step="1000" class="w-full pl-8 pr-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none transition-all font-semibold" placeholder="0" />
                    </div>
                    <span asp-validation-for="Price" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="StockQuantity" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                    <input asp-for="StockQuantity" type="number" class="w-full px-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none transition-all font-semibold" placeholder="Số lượng kho hàng ban đầu" />
                    <span asp-validation-for="StockQuantity" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="Description" class="block text-xs font-bold text-slate-700 dark:text-gray-300 uppercase tracking-wider mb-2"></label>
                <textarea asp-for="Description" rows="4" class="w-full px-4 py-2.5 text-sm border border-slate-200 dark:border-gray-700 rounded-xl focus:ring-2 focus:ring-primary focus:outline-none transition-all" placeholder="Thông số kỹ thuật, bảo hành, tính năng nổi bật..."></textarea>
                <span asp-validation-for="Description" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div class="p-4 bg-slate-50 dark:bg-gray-800 rounded-2xl border border-slate-100 dark:border-gray-800 flex items-start space-x-3">
                <input asp-for="IsActive" type="checkbox" class="mt-1 h-4 w-4 text-primary dark:text-indigo-300 focus:ring-primary border-slate-300 dark:border-gray-600 rounded cursor-pointer" />
                <div>
                    <label asp-for="IsActive" class="text-xs font-bold text-slate-800 dark:text-gray-200 cursor-pointer"></label>
                    <p class="text-xs text-slate-400 mt-0.5">Khi bỏ chọn, sản phẩm sẽ được tự động ẩn khỏi khách hàng (Lưu kho).</p>
                </div>
            </div>

            <div class="flex items-center justify-between pt-6 border-t border-slate-100 dark:border-gray-800">
                <a asp-action="Products" class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-gray-700 text-slate-600 dark:text-gray-400 hover:bg-slate-50 dark:hover:bg-gray-800 text-sm font-medium transition-colors">
                    Hủy bỏ
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary hover:bg-indigo-700 text-white text-sm font-semibold shadow-md transition-colors">
                    @(isEdit ? "Lưu thay đổi" : "Tạo sản phẩm")
                </button>
            </div>
        </form>
    </div>
</div>
