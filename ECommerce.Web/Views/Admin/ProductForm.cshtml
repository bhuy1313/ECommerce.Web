@model ECommerce.Web.Models.ViewModels.ProductFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Cập nhật sản phẩm" : "Thêm sản phẩm mới";
}

<div class="max-w-3xl mx-auto py-2">
    <!-- Breadcrumb -->
    <nav class="flex text-xs text-zinc-500 dark:text-zinc-400 mb-6 items-center gap-1.5" aria-label="Breadcrumb">
        <a asp-action="Index" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Dashboard</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <a asp-action="Products" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Sản phẩm</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <span class="text-zinc-900 dark:text-zinc-100 font-medium">@(isEdit ? $"Cập nhật #{Model.Id}" : "Thêm mới")</span>
    </nav>

    <div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 p-6 sm:p-8 shadow-xs">
        <div class="flex items-center space-x-3 pb-5 mb-5 border-b border-zinc-200 dark:border-zinc-800">
            <div class="w-9 h-9 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center text-sm border border-zinc-200 dark:border-zinc-700">
                <i class="fas @(isEdit ? "fa-edit" : "fa-plus")"></i>
            </div>
            <div>
                <h1 class="text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
                    @(isEdit ? $"Cập nhật sản phẩm: {Model.Name}" : "Tạo sản phẩm mới")
                </h1>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Điền các thông số chi tiết để sản phẩm sẵn sàng mở bán</p>
            </div>
        </div>

        <form asp-action="@(isEdit ? "EditProduct" : "CreateProduct")" method="post" novalidate class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="p-2.5 bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/40 text-rose-700 dark:text-rose-300 rounded-md text-xs" role="alert"></div>

            <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
                <div class="sm:col-span-8">
                    <label asp-for="Name" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                    <input asp-for="Name" class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" placeholder="Ví dụ: Bàn phím cơ Keychron K8 Pro" />
                    <span asp-validation-for="Name" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div class="sm:col-span-4">
                    <label asp-for="CategoryId" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                    <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Price" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-zinc-400 text-xs font-medium">đ</span>
                        <input asp-for="Price" type="number" step="1000" class="w-full pl-7 pr-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100 font-medium" placeholder="0" />
                    </div>
                    <span asp-validation-for="Price" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="StockQuantity" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                    <input asp-for="StockQuantity" type="number" class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100 font-medium" placeholder="Số lượng kho hàng ban đầu" />
                    <span asp-validation-for="StockQuantity" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="Description" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                <textarea asp-for="Description" rows="3" class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" placeholder="Thông số kỹ thuật, bảo hành, tính năng nổi bật..."></textarea>
                <span asp-validation-for="Description" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ImageUrl" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                <div class="flex items-center gap-3">
                    <img id="image-url-preview" src="@ProductImage.Resolve(Model.ImageUrl)" onerror="this.onerror=null;this.src='@ProductImage.Placeholder';" alt="Xem trước ảnh sản phẩm" class="w-12 h-12 rounded border border-zinc-200 dark:border-zinc-700 object-contain bg-white dark:bg-zinc-800 p-0.5 flex-shrink-0" />
                    <div class="flex-1">
                        <input asp-for="ImageUrl" class="w-full px-3 py-2 text-xs border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" placeholder="https://cdn.example.com/anh-san-pham.jpg hoặc /img/ten-file.png" />
                        <span asp-validation-for="ImageUrl" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="p-3 bg-zinc-50 dark:bg-zinc-800/40 rounded-md border border-zinc-200 dark:border-zinc-800 flex items-start space-x-2.5">
                <input asp-for="IsActive" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-zinc-300 dark:border-zinc-700 text-zinc-900 accent-zinc-900 dark:accent-zinc-100 cursor-pointer" />
                <div>
                    <label asp-for="IsActive" class="text-xs font-medium text-zinc-900 dark:text-zinc-200 cursor-pointer"></label>
                    <p class="text-[11px] text-zinc-500 dark:text-zinc-400">Khi bỏ chọn, sản phẩm sẽ được tự động ẩn khỏi khách hàng (Lưu kho).</p>
                </div>
            </div>

            <div class="flex items-center justify-between pt-5 border-t border-zinc-200 dark:border-zinc-800">
                <a asp-action="Products" class="px-3.5 py-1.5 rounded-md border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800 text-xs font-medium active:scale-[0.98] transition-all">
                    Hủy bỏ
                </a>
                <button type="submit" class="px-4 py-2 rounded-md bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 text-xs font-medium active:scale-[0.98] transition-all shadow-sm">
                    @(isEdit ? "Lưu thay đổi" : "Tạo sản phẩm")
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById('ImageUrl');
        var preview = document.getElementById('image-url-preview');
        if (!input || !preview) return;
        var fallback = '@ProductImage.Placeholder';
        input.addEventListener('input', function () {
            var value = input.value.trim();
            preview.src = value === '' ? fallback : value;
        });
        preview.addEventListener('error', function () {
            preview.onerror = null;
            preview.src = fallback;
        });
    })();
</script>