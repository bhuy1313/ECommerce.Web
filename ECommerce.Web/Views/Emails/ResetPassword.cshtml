@model ECommerce.Web.Models.ViewModels.EmailLinkViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đặt lại mật khẩu</title>
</head>
<body style="margin:0;padding:24px;background:#f8fafc;font-family:Arial,Helvetica,sans-serif;color:#1e293b;">
    <div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:12px;padding:32px;">
        <h1 style="font-size:20px;margin:0 0 16px;">Đặt lại mật khẩu</h1>
        <p style="font-size:14px;line-height:1.6;margin:0 0 16px;">
            Chúng tôi nhận được yêu cầu đặt lại mật khẩu cho tài khoản TechNova của bạn.
            Nhấn vào nút bên dưới để tạo mật khẩu mới.
        </p>
        <p style="margin:24px 0;">
            <a href="@Model.Url" style="display:inline-block;padding:12px 24px;background:#4f46e5;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:bold;">Đặt lại mật khẩu</a>
        </p>
        <p style="font-size:12px;color:#64748b;line-height:1.6;margin:0;">
            Liên kết có hiệu lực trong 1 giờ. Nếu bạn không yêu cầu đặt lại mật khẩu, hãy bỏ qua email này.
        </p>
    </div>
</body>
</html>
