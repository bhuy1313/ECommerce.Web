@model ECommerce.Web.Models.ViewModels.OrderConfirmationEmailViewModel
@using ECommerce.Web.Models.Entities.Enums
@{
    Layout = null;
    var order = Model.Order;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Xác nhận đơn hàng #@order.Id</title>
</head>
<body style="margin:0;padding:24px;background:#f8fafc;font-family:Arial,Helvetica,sans-serif;color:#1e293b;">
    <div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:12px;padding:32px;">
        <h1 style="font-size:20px;margin:0 0 16px;">Xác nhận đơn hàng #@order.Id</h1>
        <p style="font-size:14px;line-height:1.6;margin:0 0 16px;">
            Xin chào @order.RecipientName, cảm ơn bạn đã đặt hàng tại TechNova.
            Đơn hàng của bạn đã được ghi nhận và đang được xử lý.
        </p>
        <table style="width:100%;border-collapse:collapse;font-size:14px;">
            <thead>
                <tr style="background:#f1f5f9;text-align:left;">
                    <th style="padding:8px;">Sản phẩm</th>
                    <th style="padding:8px;text-align:center;">SL</th>
                    <th style="padding:8px;text-align:right;">Đơn giá</th>
                    <th style="padding:8px;text-align:right;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in order.Items)
                {
                    <tr style="border-bottom:1px solid #e2e8f0;">
                        <td style="padding:8px;">@item.ProductName</td>
                        <td style="padding:8px;text-align:center;">@item.Quantity</td>
                        <td style="padding:8px;text-align:right;">@item.UnitPrice.ToString("N0") ₫</td>
                        <td style="padding:8px;text-align:right;">@((item.Quantity * item.UnitPrice).ToString("N0")) ₫</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (order.ShippingFee > 0)
        {
            <p style="font-size:14px;margin:16px 0 0;text-align:right;">
                Phí vận chuyển: <strong>@order.ShippingFee.ToString("N0") ₫</strong>
            </p>
        }
        @if (order.DiscountAmount > 0)
        {
            <p style="font-size:14px;margin:@(order.ShippingFee > 0 ? "6px" : "16px") 0 0;text-align:right;color:#059669;">
                Giảm giá (@order.CouponCode): <strong>-@order.DiscountAmount.ToString("N0") ₫</strong>
            </p>
        }
        @if (order.TaxAmount > 0)
        {
            <p style="font-size:14px;margin:@(order.DiscountAmount > 0 || order.ShippingFee > 0 ? "6px" : "16px") 0 0;text-align:right;">
                Thuế VAT: <strong>@order.TaxAmount.ToString("N0") ₫</strong>
            </p>
        }
        <p style="font-size:15px;margin:@(order.DiscountAmount > 0 || order.ShippingFee > 0 || order.TaxAmount > 0 ? "6px" : "16px") 0 0;text-align:right;">
            Tổng cộng: <strong>@order.TotalAmount.ToString("N0") ₫</strong>
        </p>
        <p style="font-size:14px;line-height:1.6;margin:16px 0 0;">
            Phương thức thanh toán:
            @(order.Method == PaymentMethod.Cod ? "Thanh toán khi nhận hàng (COD)" : "VNPay")
        </p>
        <p style="font-size:14px;line-height:1.6;margin:4px 0 0;">
            Giao đến: @order.RecipientName – @order.RecipientPhone
        </p>
        <p style="font-size:14px;line-height:1.6;margin:4px 0 0;">
            @order.ShippingAddress
        </p>
        <p style="margin:24px 0 0;">
            <a href="@Model.OrderUrl" style="display:inline-block;padding:12px 24px;background:#4f46e5;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:bold;">Xem chi tiết đơn hàng</a>
        </p>
    </div>
</body>
</html>
