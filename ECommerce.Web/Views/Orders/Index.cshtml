@model IEnumerable<ECommerce.Web.Models.Entities.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">Đơn hàng của tôi</h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Theo dõi trạng thái và tiến độ xử lý của tất cả đơn hàng</p>
        </div>
        <a asp-controller="Products" asp-action="Index" class="inline-flex items-center px-3.5 py-2 rounded-md border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800 text-xs font-medium active:scale-[0.98] transition-all">
            <i class="fas fa-shopping-bag mr-1.5 text-xs text-zinc-500"></i> Tiếp tục mua hàng
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white dark:bg-zinc-900 rounded-lg p-10 text-center border border-zinc-200 dark:border-zinc-800 shadow-sm max-w-md mx-auto">
            <div class="w-12 h-12 bg-zinc-100 dark:bg-zinc-800 rounded-full flex items-center justify-center mx-auto mb-3 text-zinc-400 text-xl">
                <i class="fas fa-receipt"></i>
            </div>
            <h2 class="text-base font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Chưa có đơn hàng nào</h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-5">Khám phá các sản phẩm công nghệ chất lượng tại cửa hàng</p>
            <a asp-controller="Products" asp-action="Index" class="inline-flex items-center px-4 py-2 rounded-md bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 font-medium text-xs active:scale-[0.98] transition-all">
                Khám phá sản phẩm
            </a>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var order in Model)
            {
                <div class="bg-white dark:bg-zinc-900 rounded-lg shadow-sm border border-zinc-200 dark:border-zinc-800 p-5 sm:p-6 transition-colors hover:border-zinc-300 dark:hover:border-zinc-700">
                    <div class="flex flex-wrap justify-between items-center pb-3.5 mb-3.5 border-b border-zinc-200 dark:border-zinc-800 gap-3">
                        <div class="flex items-center gap-2.5">
                            <span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">#ORD-@order.Id.ToString("D5")</span>
                            <span class="text-xs text-zinc-300 dark:text-zinc-700">|</span>
                            <span class="text-xs text-zinc-500 dark:text-zinc-400">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="flex items-center gap-2">
                            @switch (order.Status)
                            {
                                case ECommerce.Web.Models.Entities.Enums.OrderStatus.Pending:
                                    <span class="px-2.5 py-0.5 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-xs font-medium rounded border border-amber-200 dark:border-amber-800/50">
                                        <i class="fas fa-clock mr-1 text-[10px]"></i> Chờ xử lý
                                    </span>
                                    break;
                                case ECommerce.Web.Models.Entities.Enums.OrderStatus.Processing:
                                    <span class="px-2.5 py-0.5 bg-blue-50 dark:bg-blue-950/30 text-blue-700 dark:text-blue-400 text-xs font-medium rounded border border-blue-200 dark:border-blue-800/50">
                                        <i class="fas fa-circle-notch fa-spin mr-1 text-[10px]"></i> Đang xử lý
                                    </span>
                                    break;
                                case ECommerce.Web.Models.Entities.Enums.OrderStatus.Shipped:
                                    <span class="px-2.5 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 text-xs font-medium rounded border border-zinc-200 dark:border-zinc-700">
                                        <i class="fas fa-truck mr-1 text-[10px]"></i> Đang giao
                                    </span>
                                    break;
                                case ECommerce.Web.Models.Entities.Enums.OrderStatus.Completed:
                                    <span class="px-2.5 py-0.5 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 text-xs font-medium rounded border border-emerald-200 dark:border-emerald-800/50">
                                        <i class="fas fa-check mr-1 text-[10px]"></i> Hoàn thành
                                    </span>
                                    break;
                                case ECommerce.Web.Models.Entities.Enums.OrderStatus.Cancelled:
                                    <span class="px-2.5 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 text-xs font-medium rounded border border-zinc-200 dark:border-zinc-700">
                                        <i class="fas fa-ban mr-1 text-[10px]"></i> Đã hủy
                                    </span>
                                    break;
                            }
                        </div>
                    </div>

                    <div class="space-y-2.5 mb-4">
                        @foreach (var item in order.Items.Take(3))
                        {
                            <div class="flex justify-between items-center text-xs">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-500 text-[11px] flex-shrink-0">
                                        <i class="fas fa-box"></i>
                                    </div>
                                    <div>
                                        <p class="font-medium text-zinc-900 dark:text-zinc-100 line-clamp-1">@item.ProductName</p>
                                        <p class="text-[11px] text-zinc-400">SL: @item.Quantity × <vc:money amount="@item.UnitPrice" /></p>
                                    </div>
                                </div>
                                <span class="font-medium text-zinc-900 dark:text-zinc-100 whitespace-nowrap"><vc:money amount="@(item.Quantity * item.UnitPrice)" /></span>
                            </div>
                        }
                        @if (order.Items.Count > 3)
                        {
                            <p class="text-[11px] text-zinc-400 italic">Và @(order.Items.Count - 3) sản phẩm khác...</p>
                        }
                    </div>

                    <div class="flex flex-wrap justify-between items-center pt-3.5 border-t border-zinc-200 dark:border-zinc-800 gap-3">
                        <div class="text-xs">
                            <span class="text-zinc-500 dark:text-zinc-400">Tổng thanh toán:</span>
                            <span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 ml-1"><vc:money amount="@order.TotalAmount" /></span>
                        </div>
                        <a asp-action="Details" asp-route-id="@order.Id" class="inline-flex items-center px-3 py-1.5 bg-zinc-50 dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 text-xs font-medium rounded-md transition-all active:scale-[0.98] border border-zinc-200 dark:border-zinc-700">
                            Chi tiết <i class="fas fa-arrow-right ml-1.5 text-[10px]"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>