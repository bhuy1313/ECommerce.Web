@model ECommerce.Web.Models.Entities.Order
@using ECommerce.Web.Models.Entities.Enums
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Id}";
    var canCancel = Model.Status == ECommerce.Web.Models.Entities.Enums.OrderStatus.Pending ||
                    Model.Status == ECommerce.Web.Models.Entities.Enums.OrderStatus.Processing;
    var paymentMethodLabel = Model.Method == PaymentMethod.VnPay
        ? "VNPay"
        : "Thanh toán khi nhận hàng (COD)";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex text-xs text-zinc-500 dark:text-zinc-400 mb-6 items-center gap-1.5" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Trang chủ</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <a asp-action="Index" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Đơn hàng của tôi</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <span class="text-zinc-900 dark:text-zinc-100 font-medium">Chi tiết #@Model.Id</span>
    </nav>

    <div class="bg-white dark:bg-zinc-900 rounded-lg shadow-sm border border-zinc-200 dark:border-zinc-800 p-6 sm:p-8 mb-8">
        <!-- Header thông tin đơn -->
        <div class="flex flex-wrap justify-between items-start gap-4 pb-6 mb-6 border-b border-zinc-200 dark:border-zinc-800">
            <div>
                <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-400">Chi tiết đơn</span>
                <h1 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mt-0.5">#ORD-@Model.Id.ToString("D5")</h1>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
                    <i class="far fa-calendar-alt mr-1"></i> Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                @switch (Model.Status)
                {
                    case ECommerce.Web.Models.Entities.Enums.OrderStatus.Pending:
                        <span class="px-2.5 py-1 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-xs font-medium rounded-md border border-amber-200 dark:border-amber-800/50">
                            <i class="fas fa-clock mr-1 text-[10px]"></i> Chờ xử lý
                        </span>
                        break;
                    case ECommerce.Web.Models.Entities.Enums.OrderStatus.Processing:
                        <span class="px-2.5 py-1 bg-blue-50 dark:bg-blue-950/30 text-blue-700 dark:text-blue-400 text-xs font-medium rounded-md border border-blue-200 dark:border-blue-800/50">
                            <i class="fas fa-circle-notch fa-spin mr-1 text-[10px]"></i> Đang xử lý
                        </span>
                        break;
                    case ECommerce.Web.Models.Entities.Enums.OrderStatus.Shipped:
                        <span class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-700">
                            <i class="fas fa-truck mr-1 text-[10px]"></i> Đang giao hàng
                        </span>
                        break;
                    case ECommerce.Web.Models.Entities.Enums.OrderStatus.Completed:
                        <span class="px-2.5 py-1 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 text-xs font-medium rounded-md border border-emerald-200 dark:border-emerald-800/50">
                            <i class="fas fa-check mr-1 text-[10px]"></i> Hoàn thành
                        </span>
                        break;
                    case ECommerce.Web.Models.Entities.Enums.OrderStatus.Cancelled:
                        <span class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-700">
                            <i class="fas fa-ban mr-1 text-[10px]"></i> Đã hủy
                        </span>
                        break;
                }

                <span class="px-2.5 py-1 bg-zinc-50 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-700">
                    @if (Model.Method == PaymentMethod.VnPay)
                    {
                        <i class="fab fa-cc-visa mr-1"></i>
                    }
                    else
                    {
                        <i class="fas fa-hand-holding-usd mr-1"></i>
                    }
                    @paymentMethodLabel
                </span>

                @switch (Model.PaymentStatus)
                {
                    case PaymentStatus.Paid:
                        <span class="px-2.5 py-1 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 text-xs font-medium rounded-md border border-emerald-200 dark:border-emerald-800/50">
                            <i class="fas fa-check-double mr-1 text-[10px]"></i> Đã thanh toán
                        </span>
                        break;
                    case PaymentStatus.Refunded:
                        <span class="px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 text-xs font-medium rounded-md border border-zinc-200 dark:border-zinc-700">
                            <i class="fas fa-rotate-left mr-1 text-[10px]"></i> Đã hoàn tiền
                        </span>
                        break;
                    case PaymentStatus.RefundPending:
                        <span class="px-2.5 py-1 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-xs font-medium rounded-md border border-amber-200 dark:border-amber-800/50">
                            <i class="fas fa-hourglass-half mr-1 text-[10px]"></i> Chờ hoàn tiền
                        </span>
                        break;
                    default:
                        <span class="px-2.5 py-1 bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 text-xs font-medium rounded-md border border-amber-200 dark:border-amber-800/50">
                            <i class="fas fa-hourglass-half mr-1 text-[10px]"></i> Chưa thanh toán
                        </span>
                        break;
                }
            </div>
        </div>

        @if (Model.Status == ECommerce.Web.Models.Entities.Enums.OrderStatus.Cancelled)
        {
            <div class="mb-6 bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/40 text-rose-800 dark:text-rose-200 px-4 py-3 rounded-md flex items-start text-xs leading-relaxed">
                <i class="fas fa-info-circle text-rose-500 mr-2.5 mt-0.5"></i>
                <div>
                    <strong>Đơn hàng đã hủy:</strong> Toàn bộ số lượng sản phẩm trong đơn đã được hoàn trả lại tồn kho khả dụng của hệ thống.
                    @if (Model.PaymentStatus == PaymentStatus.RefundPending)
                    {
                        <span class="block mt-1 font-medium">Đơn đã thanh toán trước khi hủy: khoản tiền đang chờ được hoàn lại cho bạn.</span>
                    }
                </div>
            </div>
        }

        <!-- Bảng danh sách sản phẩm -->
        <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3">Các mặt hàng đã đặt</h2>
        <div class="overflow-x-auto border border-zinc-200 dark:border-zinc-800 rounded-md mb-6">
            <table class="w-full text-left text-xs">
                <thead class="bg-zinc-50 dark:bg-zinc-800/50 text-zinc-500 dark:text-zinc-400 uppercase tracking-wider text-[11px] border-b border-zinc-200 dark:border-zinc-800">
                    <tr>
                        <th class="py-2.5 px-4 font-medium">Tên sản phẩm</th>
                        <th class="py-2.5 px-4 font-medium text-center">Số lượng</th>
                        <th class="py-2.5 px-4 font-medium text-right">Đơn giá</th>
                        <th class="py-2.5 px-4 font-medium text-right">Thành tiền</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800">
                    @foreach (var item in Model.Items)
                    {
                        var lineTotal = item.Quantity * item.UnitPrice;
                        <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30">
                            <td class="py-3 px-4 font-medium text-zinc-900 dark:text-zinc-100">
                                @item.ProductName
                            </td>
                            <td class="py-3 px-4 text-center text-zinc-600 dark:text-zinc-400">
                                @item.Quantity
                            </td>
                            <td class="py-3 px-4 text-right text-zinc-600 dark:text-zinc-400">
                                <vc:money amount="@item.UnitPrice" />
                            </td>
                            <td class="py-3 px-4 text-right font-medium text-zinc-900 dark:text-zinc-100">
                                <vc:money amount="@lineTotal" />
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-zinc-50/60 dark:bg-zinc-800/40 border-t border-zinc-200 dark:border-zinc-800 text-xs">
                    @if (Model.ShippingFee > 0)
                    {
                        <tr>
                            <td colspan="3" class="py-2.5 px-4 text-right text-zinc-500 dark:text-zinc-400">Phí vận chuyển:</td>
                            <td class="py-2.5 px-4 text-right font-medium text-zinc-900 dark:text-zinc-100"><vc:money amount="@Model.ShippingFee" /></td>
                        </tr>
                    }
                    @if (Model.DiscountAmount > 0)
                    {
                        <tr>
                            <td colspan="3" class="py-2.5 px-4 text-right text-emerald-600 dark:text-emerald-400">Giảm giá (@Model.CouponCode):</td>
                            <td class="py-2.5 px-4 text-right font-medium text-emerald-600 dark:text-emerald-400">-<vc:money amount="@Model.DiscountAmount" /></td>
                        </tr>
                    }
                    @if (Model.TaxAmount > 0)
                    {
                        <tr>
                            <td colspan="3" class="py-2.5 px-4 text-right text-zinc-500 dark:text-zinc-400">Thuế VAT:</td>
                            <td class="py-2.5 px-4 text-right font-medium text-zinc-900 dark:text-zinc-100"><vc:money amount="@Model.TaxAmount" /></td>
                        </tr>
                    }
                    <tr>
                        <td colspan="3" class="py-3 px-4 text-right font-semibold text-zinc-900 dark:text-zinc-100 border-t border-zinc-200 dark:border-zinc-800">Tổng thanh toán:</td>
                        <td class="py-3 px-4 text-right font-bold text-zinc-900 dark:text-zinc-100 text-base border-t border-zinc-200 dark:border-zinc-800"><vc:money amount="@Model.TotalAmount" /></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Thông tin nhận hàng -->
        <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3">Thông tin nhận hàng</h2>
        <div class="border border-zinc-200 dark:border-zinc-800 rounded-md mb-6 p-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-xs bg-zinc-50/50 dark:bg-zinc-850">
            <div>
                <span class="block text-[11px] text-zinc-400 mb-0.5">Người nhận</span>
                <span class="text-zinc-900 dark:text-zinc-100 font-medium">@Model.RecipientName</span>
            </div>
            <div>
                <span class="block text-[11px] text-zinc-400 mb-0.5">Số điện thoại</span>
                <span class="text-zinc-900 dark:text-zinc-100 font-medium">@Model.RecipientPhone</span>
            </div>
            <div class="sm:col-span-2">
                <span class="block text-[11px] text-zinc-400 mb-0.5">Địa chỉ giao hàng</span>
                <span class="text-zinc-900 dark:text-zinc-100 whitespace-pre-line">@Model.ShippingAddress</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <div class="sm:col-span-2">
                    <span class="block text-[11px] text-zinc-400 mb-0.5">Ghi chú</span>
                    <span class="text-zinc-600 dark:text-zinc-400 whitespace-pre-line">@Model.Note</span>
                </div>
            }
        </div>

        <!-- Thao tác đơn hàng -->
        <div class="flex flex-wrap justify-between items-center pt-4 border-t border-zinc-200 dark:border-zinc-800 gap-3">
            <a asp-action="Index" class="inline-flex items-center px-3.5 py-2 rounded-md border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800 text-xs font-medium active:scale-[0.98] transition-all">
                <i class="fas fa-arrow-left mr-1.5 text-xs"></i> Trở về danh sách đơn hàng
            </a>

            @if (canCancel)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này? Số lượng tồn kho sẽ được tự động hoàn lại.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center px-3.5 py-2 rounded-md bg-rose-50 dark:bg-rose-950/20 hover:bg-rose-100 dark:hover:bg-rose-900/40 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-900/50 text-xs font-medium active:scale-[0.98] transition-all">
                        <i class="fas fa-times-circle mr-1.5"></i> Hủy đơn hàng
                    </button>
                </form>
            }
        </div>
    </div>
</div>