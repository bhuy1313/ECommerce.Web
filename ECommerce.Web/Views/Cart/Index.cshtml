@model ECommerce.Web.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-zinc-200 dark:border-zinc-800">
        <div>
            <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-white">
                Giỏ hàng của bạn
            </h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Kiểm tra danh sách món đồ trước khi tiến hành thanh toán</p>
        </div>
        @if (Model.Items.Any())
        {
            <form asp-action="Clear" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa toàn bộ sản phẩm khỏi giỏ hàng?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="text-xs text-zinc-500 hover:text-rose-600 font-medium transition-colors flex items-center gap-1 active:scale-95">
                    <i class="fas fa-trash-alt text-[10px]"></i> Xóa tất cả
                </button>
            </form>
        }
    </div>

    @if (!Model.Items.Any())
    {
        <div class="bg-white dark:bg-zinc-900 rounded-lg p-12 text-center border border-zinc-200 dark:border-zinc-800 max-w-xl mx-auto my-8">
            <div class="w-12 h-12 bg-zinc-100 dark:bg-zinc-800 rounded-md flex items-center justify-center mx-auto mb-3 text-zinc-400 text-xl">
                <i class="fas fa-shopping-bag"></i>
            </div>
            <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Giỏ hàng đang trống</h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-5 leading-relaxed">Bạn chưa thêm sản phẩm nào vào giỏ. Hãy khám phá danh mục để lựa chọn thiết bị phù hợp.</p>
            <a asp-controller="Products" asp-action="Index" 
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 text-xs font-medium hover:bg-zinc-800 dark:hover:bg-white transition-colors active:scale-95 shadow-sm">
                Khám phá sản phẩm ngay <i class="fas fa-arrow-right text-[10px]"></i>
            </a>
        </div>
    }
    else
    {
        @if (Model.HasAnyStockIssue)
        {
            <div class="mb-6 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 px-4 py-3 rounded-md flex items-start text-xs" role="alert">
                <i class="fas fa-exclamation-triangle text-amber-500 text-sm mr-2.5 mt-0.5 flex-shrink-0"></i>
                <div class="leading-relaxed">
                    <span class="font-bold">Lưu ý tồn kho:</span> Một số sản phẩm trong giỏ vượt quá số lượng hàng khả dụng. Vui lòng điều chỉnh lại số lượng trước khi đặt hàng.
                </div>
            </div>
        }

        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Danh sách sản phẩm -->
            <div class="w-full lg:w-2/3">
                <div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
                    <!-- Bảng Desktop -->
                    <table class="w-full text-left hidden sm:table text-xs">
                        <thead class="bg-zinc-50 dark:bg-zinc-800/50 border-b border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400 uppercase tracking-wider text-[11px]">
                            <tr>
                                <th class="py-3 px-5 font-semibold">Sản phẩm</th>
                                <th class="py-3 px-4 font-semibold text-right">Đơn giá</th>
                                <th class="py-3 px-4 font-semibold text-center">Số lượng</th>
                                <th class="py-3 px-4 font-semibold text-right">Thành tiền</th>
                                <th class="py-3 px-3 font-semibold text-center">Xóa</th>
                            </tr>
                        </thead>
                        <tbody id="cart-items-tbody" class="divide-y divide-zinc-100 dark:divide-zinc-800">
                            @foreach (var item in Model.Items)
                            {
                                <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition-colors @(item.HasStockIssue ? "bg-rose-50/40 dark:bg-rose-950/20" : "")">
                                    <td class="py-3.5 px-5">
                                        <div class="flex items-center gap-3">
                                            <div class="w-12 h-12 bg-zinc-50 dark:bg-zinc-800 rounded-md flex items-center justify-center flex-shrink-0 border border-zinc-200/80 dark:border-zinc-700/80 p-1.5">
                                                <img src="@ProductImage.Resolve(item.ImageUrl)" alt="@item.ProductName" class="max-w-full max-h-full object-contain">
                                            </div>
                                            <div>
                                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" 
                                                   class="font-medium text-zinc-900 dark:text-zinc-100 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors line-clamp-1">
                                                    @item.ProductName
                                                </a>
                                                <span class="text-[11px] text-zinc-400 mt-0.5 block">@item.CategoryName</span>
                                                @if (item.HasStockIssue)
                                                {
                                                    <span class="inline-block mt-1 text-[10px] font-semibold text-rose-600 bg-rose-50 dark:bg-rose-950/60 dark:text-rose-300 px-1.5 py-0.2 rounded border border-rose-200 dark:border-rose-800">
                                                        @(item.AvailableStock <= 0 ? "Hết hàng" : $"Chỉ còn {item.AvailableStock} sp")
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-medium text-zinc-700 dark:text-zinc-300">
                                        <vc:money amount="@item.UnitPrice" />
                                    </td>
                                    <td class="py-3.5 px-4 text-center">
                                        <form asp-action="UpdateQuantity" method="post" class="inline-flex items-center justify-center border border-zinc-200 dark:border-zinc-700 rounded-md bg-zinc-50 dark:bg-zinc-800/60 overflow-hidden">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" name="quantity" value="@(item.Quantity - 1)" 
                                                    class="px-2 py-1 text-zinc-500 hover:text-zinc-950 dark:hover:text-white transition active:scale-90 focus:outline-none" title="Giảm 1">
                                                <i class="fas fa-minus text-[10px]"></i>
                                            </button>
                                            <input type="number" readonly value="@item.Quantity" class="w-8 text-center text-xs font-semibold text-zinc-900 dark:text-zinc-100 bg-transparent focus:outline-none" />
                                            <button type="submit" name="quantity" value="@(item.Quantity + 1)" 
                                                    class="px-2 py-1 text-zinc-500 hover:text-zinc-950 dark:hover:text-white transition active:scale-90 focus:outline-none" title="Tăng 1">
                                                <i class="fas fa-plus text-[10px]"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="py-3.5 px-4 text-right font-bold text-zinc-950 dark:text-white">
                                        <vc:money amount="@item.LineTotal" />
                                    </td>
                                    <td class="py-3.5 px-3 text-center">
                                        <form asp-action="RemoveItem" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="text-zinc-400 hover:text-rose-600 p-1.5 transition-colors active:scale-90" title="Xóa khỏi giỏ">
                                                <i class="fas fa-trash-alt text-xs"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Mobile List -->
                    <div id="cart-items-mobile" class="sm:hidden p-4 space-y-4 divide-y divide-zinc-100 dark:divide-zinc-800">
                        @foreach (var item in Model.Items)
                        {
                            <div class="pt-4 first:pt-0 flex gap-3 text-xs">
                                <div class="w-14 h-14 bg-zinc-50 dark:bg-zinc-800 rounded-md p-1.5 flex-shrink-0 border border-zinc-200 dark:border-zinc-700">
                                    <img src="@ProductImage.Resolve(item.ImageUrl)" alt="@item.ProductName" class="max-w-full max-h-full object-contain">
                                </div>
                                <div class="flex-1 flex flex-col">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="font-medium text-zinc-900 dark:text-zinc-100 line-clamp-1 mb-1">
                                        @item.ProductName
                                    </a>
                                    <span class="font-bold text-zinc-950 dark:text-white mb-2"><vc:money amount="@item.LineTotal" /></span>

                                    <div class="flex items-center justify-between mt-auto">
                                        <form asp-action="UpdateQuantity" method="post" class="flex items-center border border-zinc-200 dark:border-zinc-700 rounded-md bg-zinc-50 dark:bg-zinc-800/60">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="px-2 py-0.5 text-zinc-500 active:scale-90"><i class="fas fa-minus text-[10px]"></i></button>
                                            <input type="text" readonly value="@item.Quantity" class="w-7 text-center text-xs font-semibold bg-transparent focus:outline-none" />
                                            <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="px-2 py-0.5 text-zinc-500 active:scale-90"><i class="fas fa-plus text-[10px]"></i></button>
                                        </form>
                                        <form asp-action="RemoveItem" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="text-zinc-400 hover:text-rose-500 p-1 active:scale-90"><i class="fas fa-trash-alt text-xs"></i></button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="p-4 bg-zinc-50 dark:bg-zinc-900/60 border-t border-zinc-200 dark:border-zinc-800 flex justify-between items-center text-xs">
                        <a asp-controller="Products" asp-action="Index" class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white font-medium inline-flex items-center gap-1.5 transition-colors">
                            <i class="fas fa-arrow-left text-[10px]"></i> Tiếp tục mua sắm
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tóm tắt Đơn hàng -->
            <div class="w-full lg:w-1/3">
                <div class="bg-white dark:bg-zinc-900 rounded-lg p-5 border border-zinc-200 dark:border-zinc-800 sticky top-24 text-xs">
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-950 dark:text-white mb-4 border-b border-zinc-100 dark:border-zinc-800 pb-3">
                        Tóm tắt đơn hàng
                    </h2>

                    <div class="space-y-3 text-zinc-600 dark:text-zinc-400 mb-5 border-b border-zinc-100 dark:border-zinc-800 pb-4">
                        <div class="flex justify-between">
                            <span>Tạm tính (@Model.TotalItems sản phẩm):</span>
                            <span class="font-semibold text-zinc-900 dark:text-zinc-100"><vc:money amount="@Model.TotalAmount" /></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Phí vận chuyển:</span>
                            <span class="text-zinc-400">Tính ở bước thanh toán</span>
                        </div>
                    </div>

                    <div class="flex justify-between items-baseline mb-6">
                        <span class="text-zinc-900 dark:text-zinc-100 font-semibold text-sm">Tổng tạm tính:</span>
                        <div class="text-right">
                            <span class="block text-xl font-bold text-zinc-950 dark:text-white tracking-tight"><vc:money amount="@Model.TotalAmount" /></span>
                            <span class="text-[11px] text-zinc-400">(Chưa gồm phí ship &amp; thuế)</span>
                        </div>
                    </div>

                    @if (Model.HasAnyStockIssue)
                    {
                        <button disabled class="w-full bg-zinc-200 dark:bg-zinc-800 text-zinc-400 font-medium py-3 px-4 rounded-md cursor-not-allowed text-center text-xs">
                            Vui lòng điều chỉnh lại số lượng
                        </button>
                    }
                    else
                    {
                        <a asp-action="Checkout" 
                           class="w-full bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 hover:bg-zinc-800 dark:hover:bg-white font-medium py-3 px-4 rounded-md transition-colors text-center block text-xs active:scale-[0.98] shadow-sm">
                            Tiến hành thanh toán <i class="fas fa-arrow-right ml-1.5 text-[10px]"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <!-- CDN AutoAnimate siêu nhẹ (2KB) tạo chuyển động trượt mượt mà khi thêm/xóa món đồ -->
    <script src="https://cdn.jsdelivr.net/npm/@@formkit/auto-animate@@0.8.2/index.min.js"></script>
    <script>
        (function () {
            if (typeof autoAnimate !== 'undefined') {
                var tbody = document.getElementById('cart-items-tbody');
                if (tbody) autoAnimate(tbody);
                var mobile = document.getElementById('cart-items-mobile');
                if (mobile) autoAnimate(mobile);
            }
        })();
    </script>
}
