@model ECommerce.Web.Models.ViewModels.CheckoutViewModel
@using ECommerce.Web.Models.Entities.Enums
@inject Microsoft.Extensions.Options.IOptions<ECommerce.Web.Models.Configuration.VnPayOptions> VnPayConfig
@{
    ViewData["Title"] = "Thanh toán an toàn";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex text-xs text-zinc-500 dark:text-zinc-400 mb-6 items-center gap-1.5" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Trang chủ</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <a asp-controller="Cart" asp-action="Index" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Giỏ hàng</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <span class="text-zinc-900 dark:text-zinc-100 font-medium">Xác nhận thanh toán</span>
    </nav>

    <div class="mb-8">
        <h1 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">Xác nhận & Hoàn tất đơn hàng</h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Kiểm tra thông tin giao nhận và tóm tắt sản phẩm trước khi tạo đơn</p>
    </div>

    <div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden shadow-sm">
        <!-- Coupon Bar -->
        <div class="p-5 sm:p-6 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-900/60">
            <form asp-controller="Cart" asp-action="Checkout" method="get" class="flex flex-col sm:flex-row gap-2 max-w-xl">
                <div class="flex-1">
                    <label for="couponCodeInput" class="sr-only">Mã giảm giá</label>
                    <input id="couponCodeInput" name="couponCode" value="@Model.CouponCode" maxlength="50"
                           placeholder="Nhập mã giảm giá (ví dụ: SAVE10)"
                           class="w-full px-3 py-2 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 uppercase placeholder:normal-case placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" />
                </div>
                <button type="submit" class="px-4 py-2 bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 text-sm font-medium rounded-md active:scale-[0.98] transition-all">
                    Áp dụng
                </button>
                @if (!string.IsNullOrEmpty(Model.CouponCode))
                {
                    <a asp-controller="Cart" asp-action="Checkout"
                       class="px-4 py-2 text-center text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 border border-zinc-300 dark:border-zinc-700 rounded-md active:scale-[0.98] transition-all">
                        Bỏ mã
                    </a>
                }
            </form>
            @if (!string.IsNullOrEmpty(Model.CouponError))
            {
                <p class="mt-2 text-xs text-rose-600 dark:text-rose-400 flex items-center gap-1.5">
                    <i class="fas fa-exclamation-circle"></i>@Model.CouponError
                </p>
            }
            else if (Model.DiscountAmount > 0)
            {
                <p class="mt-2 text-xs text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5 font-medium">
                    <i class="fas fa-check-circle"></i>@Model.CouponDescription — giảm <vc:money amount="@Model.DiscountAmount" />
                </p>
            }
        </div>

        <form asp-controller="Orders" asp-action="Checkout" method="post">
        <div class="flex flex-col md:flex-row">
            <!-- Form Thông tin giao hàng -->
            <div class="w-full md:w-3/5 p-6 sm:p-8 border-b md:border-b-0 md:border-r border-zinc-200 dark:border-zinc-800">
                <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-5 flex items-center gap-2">
                    <i class="fas fa-map-marker-alt text-zinc-500"></i>Thông tin nhận hàng
                </h2>

                <div class="space-y-4 text-sm">
                    <div>
                        <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Tài khoản khách hàng</label>
                        <div class="p-2.5 bg-zinc-50 dark:bg-zinc-800/60 rounded-md border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 text-xs font-medium flex items-center">
                            <i class="fas fa-user-circle text-zinc-400 mr-2"></i>@User.Identity?.Name
                        </div>
                    </div>

                    @if (Model.SavedAddresses.Any())
                    {
                        <div>
                            <label asp-for="SavedAddressId" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Địa chỉ đã lưu</label>
                            <select asp-for="SavedAddressId" id="savedAddressSelect"
                                    class="w-full px-3 py-2 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100">
                                <option value="">— Nhập địa chỉ mới —</option>
                                @foreach (var option in Model.SavedAddresses)
                                {
                                    <option value="@option.Id" data-name="@option.RecipientName"
                                            data-phone="@option.RecipientPhone" data-address="@option.AddressLine"
                                            selected="@(Model.SavedAddressId == option.Id)">@option.Display</option>
                                }
                            </select>
                        </div>
                    }

                    <div>
                        <label asp-for="RecipientName" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                        <input asp-for="RecipientName" autocomplete="name" placeholder="Nguyễn Văn A"
                               class="w-full px-3 py-2 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" />
                        <span asp-validation-for="RecipientName" class="block mt-1 text-xs text-rose-500"></span>
                    </div>

                    <div>
                        <label asp-for="RecipientPhone" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                        <input asp-for="RecipientPhone" type="tel" autocomplete="tel" placeholder="09xx xxx xxx"
                               class="w-full px-3 py-2 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" />
                        <span asp-validation-for="RecipientPhone" class="block mt-1 text-xs text-rose-500"></span>
                    </div>

                    <div>
                        <label asp-for="ShippingAddress" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                        <textarea asp-for="ShippingAddress" rows="3" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành"
                                  class="w-full px-3 py-2 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100"></textarea>
                        <span asp-validation-for="ShippingAddress" class="block mt-1 text-xs text-rose-500"></span>
                    </div>

                    <div>
                        <label asp-for="Note" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                        <textarea asp-for="Note" rows="2" placeholder="Ví dụ: giao ngoài giờ hành chính"
                                  class="w-full px-3 py-2 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100"></textarea>
                        <span asp-validation-for="Note" class="block mt-1 text-xs text-rose-500"></span>
                    </div>

                    <div>
                        <fieldset>
                            <legend class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-2">Phương thức vận chuyển</legend>
                            @if (Model.ShippingMethods.Count == 0)
                            {
                                <p class="text-xs text-rose-600 dark:text-rose-400" role="alert">
                                    <i class="fas fa-exclamation-circle mr-1"></i>@Model.ShippingError
                                </p>
                            }
                            else
                            {
                                <div class="space-y-2.5">
                                    @foreach (var option in Model.ShippingMethods)
                                    {
                                        <label class="flex items-center p-3 border border-zinc-200 dark:border-zinc-800 rounded-lg cursor-pointer hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
                                            <input type="radio" name="ShippingMethodId" value="@option.Id"
                                                   class="h-4 w-4 text-zinc-900 focus:ring-zinc-900 dark:focus:ring-zinc-100 accent-zinc-900 dark:accent-zinc-100"
                                                   checked="@(Model.ShippingMethodId == option.Id)" />
                                            <span class="ml-3">
                                                <span class="block text-xs font-medium text-zinc-900 dark:text-zinc-100">@option.Name</span>
                                                @if (!string.IsNullOrWhiteSpace(option.Description))
                                                {
                                                    <span class="block text-[11px] text-zinc-500 dark:text-zinc-400">@option.Description</span>
                                                }
                                            </span>
                                            <span class="ml-auto text-xs font-semibold text-zinc-900 dark:text-zinc-100 whitespace-nowrap">
                                                <vc:money amount="@option.Fee" />
                                            </span>
                                        </label>
                                    }
                                </div>
                                <span asp-validation-for="ShippingMethodId" class="block mt-1 text-xs text-rose-500"></span>
                            }
                        </fieldset>
                    </div>

                    <div>
                        @{ var vnPayReady = VnPayConfig.Value.IsConfigured; }
                        <fieldset>
                            <legend class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-2">Phương thức thanh toán</legend>
                            <div class="space-y-2.5" id="paymentOptions">
                                <label class="flex items-center p-3 border border-zinc-200 dark:border-zinc-800 rounded-lg cursor-pointer hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
                                    <input type="radio" name="PaymentMethod" value="Cod" id="paymentMethodCod" class="h-4 w-4 text-zinc-900 focus:ring-zinc-900 dark:focus:ring-zinc-100 accent-zinc-900 dark:accent-zinc-100" @(Model.PaymentMethod == PaymentMethod.Cod || !vnPayReady ? "checked" : null) />
                                    <span class="ml-3 text-xs font-medium text-zinc-900 dark:text-zinc-100">Thanh toán khi nhận hàng (COD)</span>
                                    <i class="fas fa-hand-holding-usd text-zinc-400 ml-auto text-base"></i>
                                </label>
                                @if (vnPayReady)
                                {
                                    <label class="flex items-center p-3 border border-zinc-200 dark:border-zinc-800 rounded-lg cursor-pointer hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
                                        <input type="radio" name="PaymentMethod" value="VnPay" id="paymentMethodVnPay" class="h-4 w-4 text-zinc-900 focus:ring-zinc-900 dark:focus:ring-zinc-100 accent-zinc-900 dark:accent-zinc-100" @(Model.PaymentMethod == PaymentMethod.VnPay ? "checked" : null) />
                                        <span class="ml-3 text-xs font-medium text-zinc-900 dark:text-zinc-100">Chuyển khoản / Cổng thanh toán VNPay</span>
                                        <i class="fab fa-cc-visa text-zinc-400 ml-auto text-base"></i>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="PaymentMethod" class="block mt-1 text-xs text-rose-500"></span>
                        </fieldset>
                        @if (vnPayReady)
                        {
                            <div id="vnPayNote" class="hidden mt-3 p-3 bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/40 rounded-md text-xs text-amber-800 dark:text-amber-200 flex items-start gap-2">
                                <i class="fas fa-info-circle text-amber-500 mt-0.5"></i>
                                <span>Bạn sẽ được chuyển tới cổng thanh toán VNPay để hoàn tất giao dịch. Đơn hàng chỉ được ghi nhận là đã thanh toán sau khi VNPay xác nhận với hệ thống.</span>
                            </div>
                        }
                    </div>

                    <div class="mt-6 p-3.5 bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-200 dark:border-zinc-800 rounded-md text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed flex items-start gap-2.5">
                        <i class="fas fa-shield-alt text-zinc-400 text-sm mt-0.5"></i>
                        <div>
                            <strong class="text-zinc-900 dark:text-zinc-200 font-medium">Bảo đảm tồn kho an toàn:</strong> Khi bạn bấm "Xác nhận Đặt Hàng", hệ thống sẽ tự động tạo đơn, kích hoạt transaction để trừ kho và lưu đơn hàng vào lịch sử tài khoản của bạn.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Review Đơn hàng -->
            <div class="w-full md:w-2/5 bg-zinc-50/70 dark:bg-zinc-900/40 p-6 sm:p-8 flex flex-col justify-between">
                <div>
                    <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-5 flex items-center justify-between">
                        <span>Đơn hàng của bạn</span>
                        <span class="text-xs bg-zinc-200 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 font-medium px-2 py-0.5 rounded">@Model.Cart.TotalItems món</span>
                    </h2>

                    <!-- Mini Cart Items -->
                    <div class="overflow-y-auto max-h-64 pr-1 mb-6 space-y-3 divide-y divide-zinc-200 dark:divide-zinc-800">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="pt-3 first:pt-0 flex justify-between items-start gap-3 text-sm">
                                <div class="flex gap-3">
                                    <div class="w-12 h-12 bg-white dark:bg-zinc-800 rounded border border-zinc-200 dark:border-zinc-700 flex items-center justify-center p-1 flex-shrink-0">
                                        <img src="@ProductImage.Resolve(item.ImageUrl)" alt="@item.ProductName" class="w-full h-full object-contain">
                                    </div>
                                    <div>
                                        <p class="text-xs font-medium text-zinc-900 dark:text-zinc-100 line-clamp-1">@item.ProductName</p>
                                        <p class="text-[11px] text-zinc-500 dark:text-zinc-400">SL: @item.Quantity × <vc:money amount="@item.UnitPrice" /></p>
                                    </div>
                                </div>
                                <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 whitespace-nowrap"><vc:money amount="@item.LineTotal" /></span>
                            </div>
                        }
                    </div>

                    <!-- Totals -->
                    <div class="border-t border-zinc-200 dark:border-zinc-800 pt-4 space-y-2 mb-6 text-xs">
                        <div class="flex justify-between text-zinc-600 dark:text-zinc-400">
                            <span>Tạm tính</span>
                            <span class="font-medium text-zinc-900 dark:text-zinc-100"><vc:money amount="@Model.Cart.TotalAmount" /></span>
                        </div>
                        <div class="flex justify-between text-zinc-600 dark:text-zinc-400">
                            <span>Phí vận chuyển</span>
                            @if (Model.ShippingMethodId.HasValue)
                            {
                                <span class="font-medium text-zinc-900 dark:text-zinc-100"><vc:money amount="@Model.ShippingFee" /></span>
                            }
                            else
                            {
                                <span class="text-zinc-400">Chưa chọn</span>
                            }
                        </div>
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="flex justify-between text-emerald-600 dark:text-emerald-400 font-medium">
                                <span>Giảm giá (@Model.CouponCode)</span>
                                <span>-<vc:money amount="@Model.DiscountAmount" /></span>
                            </div>
                        }
                        @if (Model.ShippingMethodId.HasValue)
                        {
                            <div class="flex justify-between text-zinc-600 dark:text-zinc-400">
                                <span>Thuế VAT (@((Model.TaxRate * 100).ToString("0.#"))%)</span>
                                <span class="font-medium text-zinc-900 dark:text-zinc-100"><vc:money amount="@Model.TaxAmount" /></span>
                            </div>
                        }
                        <div class="flex justify-between text-sm font-semibold text-zinc-900 dark:text-zinc-100 pt-3 border-t border-zinc-200 dark:border-zinc-800">
                            <span>Tổng thanh toán</span>
                            <span class="text-base font-bold"><vc:money amount="@Model.PayableTotal" /></span>
                        </div>
                        <p class="text-[10px] text-zinc-400 italic">Ngoại tệ chỉ để tham khảo — đơn hàng thanh toán bằng VNĐ.</p>
                    </div>
                </div>

                <div class="space-y-3 pt-4">
                    <button type="submit" disabled="@(Model.ShippingMethods.Count == 0)" class="w-full bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 font-medium py-3 px-4 rounded-md shadow-sm active:scale-[0.98] transition-all text-sm flex items-center justify-center gap-2 group disabled:opacity-50 disabled:cursor-not-allowed">
                        <span>Xác nhận Đặt Hàng</span>
                        <i class="fas fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
                    </button>
                    <a asp-controller="Cart" asp-action="Index" class="block w-full text-center text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
                        ← Quay lại giỏ hàng
                    </a>
                </div>
            </div>
        </div>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CouponCode" />
        </form>
    </div>
</div>

<script>
    (function () {
        var options = document.querySelectorAll('#paymentOptions input[name="PaymentMethod"]');
        var note = document.getElementById('vnPayNote');

        function sync() {
            options.forEach(function (input) {
                var label = input.closest('label');
                var selected = input.checked;
                label.classList.toggle('border-zinc-900', selected);
                label.classList.toggle('dark:border-zinc-100', selected);
                label.classList.toggle('bg-zinc-50', selected);
                label.classList.toggle('dark:bg-zinc-800/40', selected);
                label.classList.toggle('border-zinc-200', !selected);
                label.classList.toggle('dark:border-zinc-800', !selected);
            });

            var vnPay = document.querySelector('#paymentOptions input[value="VnPay"]');
            if (note) note.classList.toggle('hidden', !(vnPay && vnPay.checked));
        }

        options.forEach(function (input) {
            input.addEventListener('change', sync);
        });

        sync();
    })();
</script>

<script>
    (function () {
        var select = document.getElementById('savedAddressSelect');
        if (!select) return;
        var name = document.getElementById('RecipientName');
        var phone = document.getElementById('RecipientPhone');
        var address = document.getElementById('ShippingAddress');

        select.addEventListener('change', function () {
            var option = select.options[select.selectedIndex];
            if (!select.value || !option) return;
            name.value = option.dataset.name;
            phone.value = option.dataset.phone;
            address.value = option.dataset.address;
        });
    })();
</script>