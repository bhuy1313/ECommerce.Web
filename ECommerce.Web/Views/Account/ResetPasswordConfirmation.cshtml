@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="min-h-[75vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute -top-32 -right-32 w-80 h-80 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-md w-full relative z-10">
        <div class="bg-white dark:bg-gray-900 p-8 sm:p-10 rounded-3xl shadow-xl border border-gray-100 dark:border-gray-800 text-center">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-emerald-50 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-300 mb-3">
                <i class="fas fa-check-circle text-2xl"></i>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100">Đặt lại mật khẩu thành công</h2>
            <p class="text-gray-500 dark:text-gray-400 text-sm mt-2">
                Mật khẩu của bạn đã được đặt lại. Vui lòng đăng nhập bằng mật khẩu mới.
            </p>

            <a asp-action="Login" class="mt-8 inline-flex justify-center w-full py-3.5 px-4 rounded-xl shadow-md text-sm font-bold text-white bg-primary hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-all">
                Đăng nhập
            </a>
        </div>
    </div>
</div>
