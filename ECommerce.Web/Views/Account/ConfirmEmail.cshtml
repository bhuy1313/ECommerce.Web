@model ECommerce.Web.Models.ViewModels.ConfirmEmailViewModel
@{
    ViewData["Title"] = "Xác thực email";
}

<div class="min-h-[70vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-sm w-full">
        <div class="bg-white dark:bg-zinc-900 p-7 sm:p-8 rounded-lg border border-zinc-200 dark:border-zinc-800 shadow-sm text-center">
            <div class="inline-flex items-center justify-center w-10 h-10 rounded-md mb-3 @(Model.Success ? "bg-emerald-50 dark:bg-emerald-950/30 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50" : "bg-rose-50 dark:bg-rose-950/30 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800/50")">
                <i class="fas @(Model.Success ? "fa-check" : "fa-exclamation") text-base"></i>
            </div>
            <h1 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
                @(Model.Success ? "Xác thực thành công" : "Không thể xác thực")
            </h1>
            <p class="text-zinc-500 dark:text-zinc-400 text-xs mt-2 leading-relaxed">@Model.Message</p>

            <a asp-action="Login" class="mt-6 inline-flex justify-center w-full py-2.5 px-4 rounded-md text-sm font-medium text-white dark:text-zinc-950 bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white active:scale-[0.98] transition-all">
                Đăng nhập
            </a>

            @if (!Model.Success)
            {
                <a asp-action="ResendEmailConfirmation" class="mt-3 inline-block text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
                    Gửi lại email xác thực
                </a>
            }
        </div>
    </div>
</div>