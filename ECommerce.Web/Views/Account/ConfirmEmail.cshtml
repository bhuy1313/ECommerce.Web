@model ECommerce.Web.Models.ViewModels.ConfirmEmailViewModel
@{
    ViewData["Title"] = "Xác thực email";
}

<div class="min-h-[75vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute -top-32 -right-32 w-80 h-80 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-md w-full relative z-10">
        <div class="bg-white dark:bg-gray-900 p-8 sm:p-10 rounded-3xl shadow-xl border border-gray-100 dark:border-gray-800 text-center">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-3 @(Model.Success ? "bg-emerald-50 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-300" : "bg-rose-50 dark:bg-rose-900/40 text-rose-600 dark:text-rose-300")">
                <i class="fas @(Model.Success ? "fa-check-circle" : "fa-circle-exclamation") text-2xl"></i>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100">
                @(Model.Success ? "Xác thực thành công" : "Không thể xác thực")
            </h2>
            <p class="text-gray-500 dark:text-gray-400 text-sm mt-2">@Model.Message</p>

            <a asp-action="Login" class="mt-8 inline-flex justify-center w-full py-3.5 px-4 rounded-xl shadow-md text-sm font-bold text-white bg-primary hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-all">
                Đăng nhập
            </a>

            @if (!Model.Success)
            {
                <a asp-action="ResendEmailConfirmation" class="mt-4 inline-block text-sm font-semibold text-primary dark:text-indigo-300 hover:text-indigo-800 transition-colors">
                    Gửi lại email xác thực
                </a>
            }
        </div>
    </div>
</div>
