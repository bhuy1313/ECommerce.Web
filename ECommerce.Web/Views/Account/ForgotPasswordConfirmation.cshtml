@{
    ViewData["Title"] = "Kiểm tra hộp thư";
}

<div class="min-h-[70vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-sm w-full">
        <div class="bg-white dark:bg-zinc-900 p-7 sm:p-8 rounded-lg border border-zinc-200 dark:border-zinc-800 shadow-sm text-center">
            <div class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-emerald-50 dark:bg-emerald-950/30 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50 mb-3">
                <i class="fas fa-envelope-circle-check text-base"></i>
            </div>
            <h1 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">Kiểm tra hộp thư</h1>
            <p class="text-zinc-500 dark:text-zinc-400 text-xs mt-2 leading-relaxed">
                Nếu email tồn tại, chúng tôi đã gửi liên kết đặt lại mật khẩu. Vui lòng kiểm tra hộp thư của bạn.
            </p>

            <a asp-action="Login" class="mt-6 inline-flex justify-center w-full py-2.5 px-4 rounded-md text-sm font-medium text-white dark:text-zinc-950 bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white active:scale-[0.98] transition-all">
                Quay lại đăng nhập
            </a>
        </div>
    </div>
</div>