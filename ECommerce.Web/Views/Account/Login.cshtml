@model ECommerce.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="min-h-[70vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-sm w-full">
        <div class="bg-white dark:bg-zinc-900 p-7 sm:p-8 rounded-lg border border-zinc-200 dark:border-zinc-800 shadow-sm">
            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 mb-3">
                    <i class="fas fa-layer-group text-base"></i>
                </div>
                <h1 class="text-xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">Chào mừng trở lại</h1>
                <p class="text-zinc-500 dark:text-zinc-400 text-xs mt-1">Đăng nhập tài khoản để tiếp tục</p>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate class="space-y-4">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="p-2.5 bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/40 text-rose-700 dark:text-rose-300 rounded-md text-xs" role="alert"></div>

                <div>
                    <label asp-for="Email" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
                    <input asp-for="Email" type="email" placeholder="name@example.com" autocomplete="username"
                           class="w-full px-3 py-2 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" />
                    <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label asp-for="Password" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300"></label>
                        <a asp-action="ForgotPassword" class="text-xs text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
                            Quên mật khẩu?
                        </a>
                    </div>
                    <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password"
                           class="w-full px-3 py-2 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" />
                    <span asp-validation-for="Password" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div class="flex items-center">
                    <label class="flex items-center cursor-pointer">
                        <input asp-for="RememberMe" type="checkbox" class="h-4 w-4 rounded border-zinc-300 dark:border-zinc-700 text-zinc-900 accent-zinc-900 dark:accent-zinc-100 cursor-pointer" />
                        <span class="ml-2 text-xs text-zinc-600 dark:text-zinc-400">Ghi nhớ đăng nhập</span>
                    </label>
                </div>

                <button type="submit" class="w-full py-2.5 px-4 rounded-md text-sm font-medium text-white dark:text-zinc-950 bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white active:scale-[0.98] transition-all">
                    Đăng Nhập
                </button>
            </form>

            <div class="mt-6 pt-5 border-t border-zinc-200 dark:border-zinc-800 text-center text-xs text-zinc-500 dark:text-zinc-400">
                Chưa có tài khoản?
                <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="font-medium text-zinc-900 dark:text-zinc-100 hover:underline ml-1">
                    Đăng ký ngay
                </a>
            </div>

            <p class="mt-2.5 text-center text-[11px] text-zinc-400">
                Chưa nhận được email xác thực?
                <a asp-action="ResendEmailConfirmation" class="text-zinc-600 dark:text-zinc-300 hover:underline">
                    Gửi lại
                </a>
            </p>
        </div>
    </div>
</div>