@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="min-h-[70vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white dark:bg-gray-900 rounded-3xl shadow-xl border border-gray-100 dark:border-gray-800 p-8 sm:p-10 text-center">
        <div class="w-20 h-20 bg-rose-50 rounded-full flex items-center justify-center mx-auto mb-4 text-rose-500 text-3xl">
            <i class="fas fa-lock"></i>
        </div>
        <h1 class="text-4xl font-extrabold text-rose-600 mb-2">403</h1>
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-3">Từ chối truy cập</h2>
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-6 leading-relaxed">
            Bạn không có quyền truy cập vào khu vực này. Nếu bạn là quản trị viên, vui lòng đăng nhập bằng tài khoản có vai trò phù hợp.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 text-sm font-medium transition-colors">
                <i class="fas fa-home mr-2 text-xs"></i> Trang chủ
            </a>
            <a asp-controller="Account" asp-action="Login" class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-primary hover:bg-indigo-700 text-white text-sm font-semibold transition-colors shadow-md">
                Đăng nhập tài khoản khác
            </a>
        </div>
    </div>
</div>
