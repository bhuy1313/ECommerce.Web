<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Quản trị TechNova</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#4F46E5', // Indigo 600
                        secondary: '#10B981', // Emerald 500
                        dark: '#0F172A', // Slate 900
                        sidebar: '#1E1B4B', // Dark Indigo 950
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <script>
        // Áp theme trước khi paint để tránh nháy (FOUC): localStorage > hệ điều hành.
        (function () {
            var saved = null;
            try { saved = localStorage.getItem('technova-theme'); } catch (e) {}
            if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        html.dark { color-scheme: dark; }
        html.dark ::-webkit-scrollbar-track { background: #111827; }
        html.dark ::-webkit-scrollbar-thumb { background: #374151; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f8fafc; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-50 dark:bg-gray-950 flex h-screen overflow-hidden text-slate-800 dark:text-gray-200">

    <!-- Mobile Sidebar Backdrop -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden" onclick="toggleSidebar()"></div>

    <!-- SIDEBAR BÊN TRÁI -->
    <aside id="admin-sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-sidebar text-slate-300 flex flex-col transition-transform duration-300 -translate-x-full lg:translate-x-0 lg:static flex-shrink-0 shadow-xl">
        <!-- Logo -->
        <div class="h-16 flex items-center justify-between px-6 border-b border-indigo-900/50 bg-slate-950/40">
            <a asp-controller="Admin" asp-action="Index" class="flex items-center space-x-2 text-white font-bold text-lg">
                <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center text-white shadow-md">
                    <i class="fas fa-layer-group text-sm"></i>
                </div>
                <span>TechNova <span class="text-xs bg-indigo-500/30 text-indigo-300 font-semibold px-2 py-0.5 rounded-full border border-indigo-400/30">ADMIN</span></span>
            </a>
            <button class="lg:hidden text-slate-400 hover:text-white" onclick="toggleSidebar()">
                <i class="fas fa-times text-lg"></i>
            </button>
        </div>

        <!-- Navigation Menu -->
        <nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto">
            <div class="text-[11px] font-bold text-indigo-300/60 uppercase tracking-wider px-3 mb-2">Quản trị hệ thống</div>

            @{
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
            }

            @if (User.IsInRole(ECommerce.Web.Models.Constants.AppRoles.Admin))
            {
            <a asp-controller="Admin" asp-action="Index" class="flex items-center px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors @(currentAction == "Index" ? "bg-primary text-white shadow-md shadow-indigo-600/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                <i class="fas fa-chart-pie w-6 text-base"></i>
                <span>Tổng quan Dashboard</span>
            </a>
            }

            <a asp-controller="Admin" asp-action="Products" class="flex items-center px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors @(currentAction.StartsWith("Product") ? "bg-primary text-white shadow-md shadow-indigo-600/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                <i class="fas fa-boxes w-6 text-base"></i>
                <span>Quản lý Sản phẩm</span>
            </a>

            <a asp-controller="Admin" asp-action="Categories" class="flex items-center px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors @(currentAction.StartsWith("Categor") ? "bg-primary text-white shadow-md shadow-indigo-600/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                <i class="fas fa-tags w-6 text-base"></i>
                <span>Quản lý Danh mục</span>
            </a>

            <a asp-controller="Admin" asp-action="Orders" class="flex items-center px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors @(currentAction.StartsWith("Order") ? "bg-primary text-white shadow-md shadow-indigo-600/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                <i class="fas fa-receipt w-6 text-base"></i>
                <span>Quản lý Đơn hàng</span>
            </a>

            @if (User.IsInRole(ECommerce.Web.Models.Constants.AppRoles.Admin))
            {
            <a asp-controller="Admin" asp-action="Coupons" class="flex items-center px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors @(currentAction.StartsWith("Coupon") ? "bg-primary text-white shadow-md shadow-indigo-600/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                <i class="fas fa-ticket-alt w-6 text-base"></i>
                <span>Mã giảm giá</span>
            </a>

            <a asp-controller="Admin" asp-action="Reviews" class="flex items-center px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors @(currentAction.StartsWith("Review") ? "bg-primary text-white shadow-md shadow-indigo-600/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                <i class="fas fa-star w-6 text-base"></i>
                <span>Quản lý Đánh giá</span>
            </a>

            <a asp-controller="Admin" asp-action="ShippingMethods" class="flex items-center px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors @(currentAction.StartsWith("Shipping") ? "bg-primary text-white shadow-md shadow-indigo-600/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                <i class="fas fa-truck w-6 text-base"></i>
                <span>Phương thức Vận chuyển</span>
            </a>

            <a asp-controller="Admin" asp-action="Users" class="flex items-center px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors @(currentAction.StartsWith("User") || currentAction == "EditUserRoles" ? "bg-primary text-white shadow-md shadow-indigo-600/30" : "text-slate-300 hover:bg-white/5 hover:text-white")">
                <i class="fas fa-users-cog w-6 text-base"></i>
                <span>Quản lý Người dùng</span>
            </a>
            }
        </nav>

        <!-- Bottom Actions -->
        <div class="p-4 border-t border-indigo-900/50 space-y-2 bg-slate-950/20">
            <a asp-controller="Home" asp-action="Index" target="_blank" class="flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-semibold text-indigo-300 hover:bg-indigo-900/40 transition-colors border border-indigo-800/40">
                <span class="flex items-center"><i class="fas fa-store mr-2"></i> Xem Cửa hàng</span>
                <i class="fas fa-external-link-alt text-[10px]"></i>
            </a>

            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full flex items-center justify-center px-3.5 py-2 rounded-xl text-xs font-semibold text-rose-300 hover:bg-rose-950/40 hover:text-rose-200 transition-colors border border-rose-900/30">
                    <i class="fas fa-sign-out-alt mr-2"></i> Đăng xuất
                </button>
            </form>
        </div>
    </aside>

    <!-- KHU VỰC NỘI DUNG CHÍNH (CỘT PHẢI) -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden">
        <!-- TOPBAR -->
        <header class="h-16 bg-white dark:bg-gray-900 border-b border-slate-200 dark:border-gray-800 px-4 sm:px-8 flex items-center justify-between z-10 flex-shrink-0 shadow-sm">
            <div class="flex items-center gap-3">
                <button type="button" class="lg:hidden text-slate-600 dark:text-gray-300 hover:text-primary dark:hover:text-indigo-300 p-2" onclick="toggleSidebar()" aria-label="Mở menu">
                    <i class="fas fa-bars text-lg" aria-hidden="true"></i>
                </button>
                <div class="hidden sm:flex items-center text-xs text-slate-400 dark:text-gray-500 space-x-2">
                    <span class="text-slate-600 dark:text-gray-300 font-semibold">TechNova Admin</span>
                    <span>/</span>
                    <span class="text-primary dark:text-indigo-300 font-medium">@ViewData["Title"]</span>
                </div>
            </div>

            <div class="flex items-center space-x-4">
                <!-- Chuyển chế độ sáng/tối -->
                <button type="button" id="theme-toggle" aria-label="Chuyển chế độ sáng/tối" title="Chuyển chế độ sáng/tối" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-gray-800 text-slate-600 dark:text-amber-300 hover:bg-slate-200 dark:hover:bg-gray-700 transition-colors flex items-center justify-center">
                    <i class="fas fa-moon dark:hidden" aria-hidden="true"></i>
                    <i class="fas fa-sun hidden dark:inline" aria-hidden="true"></i>
                </button>
                <div class="flex items-center space-x-3 border-l border-slate-200 dark:border-gray-700 pl-4">
                    <div class="w-9 h-9 rounded-full bg-primary/10 text-primary dark:text-indigo-300 font-bold flex items-center justify-center text-sm border border-primary/20">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div class="hidden md:block text-left">
                        <div class="text-xs font-bold text-slate-800 dark:text-gray-200 truncate max-w-[140px]">@User.Identity?.Name</div>
                        <div class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium flex items-center">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 animate-pulse"></span> @(User.IsInRole(ECommerce.Web.Models.Constants.AppRoles.Admin) ? "Toàn quyền Quản trị" : "Vận hành cửa hàng")
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- MAIN SCROLLABLE CONTENT -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-8 bg-slate-50 dark:bg-gray-950">
            @RenderBody()
        </main>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('admin-sidebar');
            const backdrop = document.getElementById('sidebar-backdrop');
            sidebar.classList.toggle('-translate-x-full');
            backdrop.classList.toggle('hidden');
        }
        // Toggle Sáng/Tối + lưu lựa chọn (chung key với shop).
        (function () {
            var btn = document.getElementById('theme-toggle');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var dark = document.documentElement.classList.toggle('dark');
                try { localStorage.setItem('technova-theme', dark ? 'dark' : 'light'); } catch (e) {}
            });
        })();
    </script>
    @await Component.InvokeAsync("Notyf")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
