<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Quản trị TechNova</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#18181b', // Zinc 900
                        secondary: '#10b981', // Emerald 500
                        dark: '#09090b', // Zinc 950
                        sidebar: '#09090b', // Zinc 950
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <script>
        // Áp theme trước khi paint để tránh nháy (FOUC): localStorage > hệ điều hành.
        (function () {
            var saved = null;
            try { saved = localStorage.getItem('technova-theme'); } catch (e) {}
            if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        html.dark { color-scheme: dark; }
        html.dark ::-webkit-scrollbar-track { background: #09090b; }
        html.dark ::-webkit-scrollbar-thumb { background: #27272a; }
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: #f4f4f5; }
        ::-webkit-scrollbar-thumb { background: #d4d4d8; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #a1a1aa; }
    </style>
</head>
<body class="bg-zinc-50 dark:bg-zinc-950 flex h-screen overflow-hidden text-zinc-900 dark:text-zinc-100">

    <!-- Mobile Sidebar Backdrop -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-black/60 z-40 hidden lg:hidden" onclick="toggleSidebar()"></div>

    <!-- SIDEBAR BÊN TRÁI -->
    <aside id="admin-sidebar" class="fixed inset-y-0 left-0 z-50 w-60 bg-zinc-950 text-zinc-400 flex flex-col transition-transform duration-200 -translate-x-full lg:translate-x-0 lg:static flex-shrink-0 border-r border-zinc-800">
        <!-- Logo -->
        <div class="h-14 flex items-center justify-between px-5 border-b border-zinc-800 bg-zinc-950">
            <a asp-controller="Admin" asp-action="Index" class="flex items-center space-x-2 text-zinc-100 font-semibold text-sm tracking-tight">
                <div class="w-7 h-7 rounded-md bg-zinc-100 dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 flex items-center justify-center border border-zinc-700">
                    <i class="fas fa-layer-group text-xs"></i>
                </div>
                <span>TechNova <span class="text-[10px] font-mono font-medium text-zinc-400 px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800">ADMIN</span></span>
            </a>
            <button class="lg:hidden text-zinc-400 hover:text-white" onclick="toggleSidebar()">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <!-- Navigation Menu -->
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <div class="text-[10px] font-semibold text-zinc-500 uppercase tracking-wider px-2.5 mb-2">Quản trị hệ thống</div>

            @{
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
            }

            @if (User.IsInRole(ECommerce.Web.Models.Constants.AppRoles.Admin))
            {
            <a asp-controller="Admin" asp-action="Index" class="flex items-center px-3 py-2 rounded-md text-xs font-medium transition-all @(currentAction == "Index" ? "bg-zinc-800 text-white font-semibold" : "text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200")">
                <i class="fas fa-chart-pie w-5 text-xs text-zinc-400"></i>
                <span>Tổng quan</span>
            </a>
            }

            <a asp-controller="Admin" asp-action="Products" class="flex items-center px-3 py-2 rounded-md text-xs font-medium transition-all @(currentAction.StartsWith("Product") ? "bg-zinc-800 text-white font-semibold" : "text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200")">
                <i class="fas fa-boxes w-5 text-xs text-zinc-400"></i>
                <span>Sản phẩm</span>
            </a>

            <a asp-controller="Admin" asp-action="Categories" class="flex items-center px-3 py-2 rounded-md text-xs font-medium transition-all @(currentAction.StartsWith("Categor") ? "bg-zinc-800 text-white font-semibold" : "text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200")">
                <i class="fas fa-tags w-5 text-xs text-zinc-400"></i>
                <span>Danh mục</span>
            </a>

            <a asp-controller="Admin" asp-action="Orders" class="flex items-center px-3 py-2 rounded-md text-xs font-medium transition-all @(currentAction.StartsWith("Order") ? "bg-zinc-800 text-white font-semibold" : "text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200")">
                <i class="fas fa-receipt w-5 text-xs text-zinc-400"></i>
                <span>Đơn hàng</span>
            </a>

            @if (User.IsInRole(ECommerce.Web.Models.Constants.AppRoles.Admin))
            {
            <a asp-controller="Admin" asp-action="Coupons" class="flex items-center px-3 py-2 rounded-md text-xs font-medium transition-all @(currentAction.StartsWith("Coupon") ? "bg-zinc-800 text-white font-semibold" : "text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200")">
                <i class="fas fa-ticket-alt w-5 text-xs text-zinc-400"></i>
                <span>Mã giảm giá</span>
            </a>

            <a asp-controller="Admin" asp-action="Reviews" class="flex items-center px-3 py-2 rounded-md text-xs font-medium transition-all @(currentAction.StartsWith("Review") ? "bg-zinc-800 text-white font-semibold" : "text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200")">
                <i class="fas fa-star w-5 text-xs text-zinc-400"></i>
                <span>Đánh giá</span>
            </a>

            <a asp-controller="Admin" asp-action="ShippingMethods" class="flex items-center px-3 py-2 rounded-md text-xs font-medium transition-all @(currentAction.StartsWith("Shipping") ? "bg-zinc-800 text-white font-semibold" : "text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200")">
                <i class="fas fa-truck w-5 text-xs text-zinc-400"></i>
                <span>Vận chuyển</span>
            </a>

            <a asp-controller="Admin" asp-action="Users" class="flex items-center px-3 py-2 rounded-md text-xs font-medium transition-all @(currentAction.StartsWith("User") || currentAction == "EditUserRoles" ? "bg-zinc-800 text-white font-semibold" : "text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200")">
                <i class="fas fa-users-cog w-5 text-xs text-zinc-400"></i>
                <span>Người dùng</span>
            </a>
            }
        </nav>

        <!-- Bottom Actions -->
        <div class="p-3 border-t border-zinc-800 space-y-1.5 bg-zinc-950">
            <a asp-controller="Home" asp-action="Index" target="_blank" class="flex items-center justify-between px-3 py-1.5 rounded-md text-xs text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900 transition-colors">
                <span class="flex items-center"><i class="fas fa-store mr-2 text-[11px]"></i> Xem Cửa hàng</span>
                <i class="fas fa-external-link-alt text-[9px]"></i>
            </a>

            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full flex items-center justify-center px-3 py-1.5 rounded-md text-xs text-rose-400 hover:text-rose-300 hover:bg-rose-950/20 transition-colors">
                    <i class="fas fa-sign-out-alt mr-2 text-[11px]"></i> Đăng xuất
                </button>
            </form>
        </div>
    </aside>

    <!-- KHU VỰC NỘI DUNG CHÍNH (CỘT PHẢI) -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden">
        <!-- TOPBAR -->
        <header class="h-14 bg-white dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 px-4 sm:px-6 flex items-center justify-between z-10 flex-shrink-0">
            <div class="flex items-center gap-3">
                <button type="button" class="lg:hidden text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 p-1.5" onclick="toggleSidebar()" aria-label="Mở menu">
                    <i class="fas fa-bars text-sm" aria-hidden="true"></i>
                </button>
                <div class="hidden sm:flex items-center text-xs text-zinc-400 dark:text-zinc-500 space-x-1.5">
                    <span class="text-zinc-700 dark:text-zinc-300 font-medium">TechNova Admin</span>
                    <span>/</span>
                    <span class="text-zinc-900 dark:text-zinc-100 font-medium">@ViewData["Title"]</span>
                </div>
            </div>

            <div class="flex items-center space-x-3">
                <!-- Chuyển chế độ sáng/tối -->
                <button type="button" id="theme-toggle" aria-label="Chuyển chế độ sáng/tối" title="Chuyển chế độ sáng/tối" class="w-8 h-8 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-amber-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors flex items-center justify-center text-xs">
                    <i class="fas fa-moon dark:hidden" aria-hidden="true"></i>
                    <i class="fas fa-sun hidden dark:inline" aria-hidden="true"></i>
                </button>
                <div class="flex items-center space-x-2.5 border-l border-zinc-200 dark:border-zinc-800 pl-3">
                    <div class="w-7 h-7 rounded-md bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-950 font-semibold flex items-center justify-center text-xs">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                    </div>
                    <div class="hidden md:block text-left">
                        <div class="text-xs font-medium text-zinc-900 dark:text-zinc-100 truncate max-w-[130px]">@User.Identity?.Name</div>
                        <div class="text-[10px] text-zinc-400">
                            @(User.IsInRole(ECommerce.Web.Models.Constants.AppRoles.Admin) ? "Toàn quyền Quản trị" : "Vận hành")
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- MAIN SCROLLABLE CONTENT -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 bg-zinc-50 dark:bg-zinc-950">
            @RenderBody()
        </main>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('admin-sidebar');
            const backdrop = document.getElementById('sidebar-backdrop');
            sidebar.classList.toggle('-translate-x-full');
            backdrop.classList.toggle('hidden');
        }
        // Toggle Sáng/Tối + lưu lựa chọn (chung key với shop).
        (function () {
            var btn = document.getElementById('theme-toggle');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var dark = document.documentElement.classList.toggle('dark');
                try { localStorage.setItem('technova-theme', dark ? 'dark' : 'light'); } catch (e) {}
            });
        })();
    </script>
    @await Component.InvokeAsync("Notyf")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>