@inject ECommerce.Web.Services.ICartService CartService
@inject ECommerce.Web.Services.ICurrencyService CurrencyService
@{
    var cartCount = await CartService.GetCartItemCountAsync();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - TechNova</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: '#18181B', // Zinc 900
                        accent: '#D97706',  // Amber 600
                        secondary: '#0284C7', // Sky 600
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    },
                    transitionTimingFunction: {
                        spring: 'cubic-bezier(0.16, 1, 0.3, 1)',
                    }
                }
            }
        }
    </script>
    <script>
        // Áp theme trước khi paint để tránh nháy (FOUC): localStorage > hệ điều hành.
        (function () {
            var saved = null;
            try { saved = localStorage.getItem('technova-theme'); } catch (e) {}
            if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
        html.dark { color-scheme: dark; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #d4d4d8; border-radius: 3px; }
        html.dark ::-webkit-scrollbar-thumb { background: #3f3f46; }
        ::-webkit-scrollbar-thumb:hover { background: #a1a1aa; }
        @@media (prefers-reduced-motion: reduce) {
            *, ::before, ::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>
<body class="bg-zinc-50 dark:bg-zinc-950 flex flex-col min-h-screen text-zinc-800 dark:text-zinc-200 antialiased selection:bg-zinc-900 selection:text-white dark:selection:bg-zinc-100 dark:selection:text-zinc-900">

    <!-- HEADER / NAVBAR -->
    <header class="bg-white/95 dark:bg-zinc-950/95 backdrop-blur-md sticky top-0 z-50 border-b border-zinc-200/80 dark:border-zinc-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex-shrink-0 flex items-center">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group transition-opacity">
                        <span class="w-7 h-7 rounded-md bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-950 flex items-center justify-center font-bold text-xs tracking-tighter">TN</span>
                        <span class="text-lg font-bold tracking-tight text-zinc-950 dark:text-white">TechNova</span>
                    </a>
                </div>

                <!-- Thanh tìm kiếm (Desktop) -->
                <div class="hidden md:flex flex-1 max-w-md mx-8">
                    <form asp-controller="Products" asp-action="Index" method="get" class="w-full relative">
                        <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-xs pointer-events-none"></i>
                        <input type="text" name="search" value="@Context.Request.Query["search"]" 
                               class="w-full bg-zinc-100/80 dark:bg-zinc-900 border border-transparent dark:border-zinc-800 rounded-md py-1.5 pl-9 pr-3 text-sm text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:border-zinc-400 dark:focus:border-zinc-600 focus:bg-white dark:focus:bg-zinc-950 transition-colors" 
                               placeholder="Tìm kiếm sản phẩm, danh mục..." aria-label="Tìm kiếm sản phẩm">
                    </form>
                </div>

                <!-- Menu Phải (Giỏ hàng & User) -->
                <div class="flex items-center space-x-3 sm:space-x-4">
                    <a asp-controller="Products" asp-action="Index" class="text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white px-2 py-1 rounded transition-colors hidden md:block">
                        Sản phẩm
                    </a>

                    <!-- Chuyển đơn vị tiền tệ (hiển thị tham khảo, thanh toán VNĐ) -->
                    <form asp-controller="Home" asp-action="SetCurrency" method="post" title="Tỉ giá tham khảo — thanh toán bằng VNĐ">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <select name="code" onchange="this.form.submit()" aria-label="Đơn vị tiền tệ" 
                                class="bg-zinc-100 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 text-xs font-medium rounded-md px-2.5 py-1.5 border border-zinc-200 dark:border-zinc-800 cursor-pointer focus:outline-none focus:border-zinc-400">
                            @foreach (var c in CurrencyService.Supported)
                            {
                                <option value="@c.Code" selected="@(c.Code == CurrencyService.CurrentCode ? "selected" : null)">@c.Code</option>
                            }
                        </select>
                    </form>

                    <!-- Chuyển chế độ sáng/tối -->
                    <button type="button" id="theme-toggle" aria-label="Chuyển chế độ sáng/tối" title="Chuyển chế độ sáng/tối" 
                            class="w-8 h-8 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-600 dark:text-amber-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors flex items-center justify-center text-xs active:scale-95">
                        <i class="fas fa-moon dark:hidden" aria-hidden="true"></i>
                        <i class="fas fa-sun hidden dark:inline" aria-hidden="true"></i>
                    </button>

                    <!-- Giỏ hàng -->
                    <a asp-controller="Cart" asp-action="Index" aria-label="Giỏ hàng" 
                       class="relative w-8 h-8 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors flex items-center justify-center text-xs active:scale-95">
                        <i class="fas fa-shopping-bag text-sm"></i>
                        @if (cartCount > 0)
                        {
                            <span class="absolute -top-1.5 -right-1.5 bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-950 text-[10px] font-bold rounded-full h-4 min-w-[16px] px-1 flex items-center justify-center border border-white dark:border-zinc-950">
                                @cartCount
                            </span>
                        }
                    </a>

                    <!-- Avatar / Đăng nhập Partial -->
                    <partial name="_LoginPartial" />
                </div>
            </div>

            <!-- Thanh tìm kiếm (Mobile) -->
            <div class="md:hidden pb-3">
                <form asp-controller="Products" asp-action="Index" method="get" class="relative w-full">
                    <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-xs pointer-events-none"></i>
                    <input type="text" name="search" value="@Context.Request.Query["search"]" 
                           class="w-full bg-zinc-100/80 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-md py-1.5 pl-9 pr-3 text-xs text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:border-zinc-400" 
                           placeholder="Tìm kiếm sản phẩm..." aria-label="Tìm kiếm sản phẩm">
                </form>
            </div>
        </div>
    </header>

    <!-- MAIN BODY -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- FOOTER (Minimalist Editorial) -->
    <footer class="bg-white dark:bg-zinc-950 border-t border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 pt-14 pb-8 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
                <!-- Thông tin thương hiệu -->
                <div class="col-span-2 md:col-span-1">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="w-6 h-6 rounded bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-950 flex items-center justify-center font-bold text-[10px] tracking-tighter">TN</span>
                        <span class="text-base font-bold tracking-tight text-zinc-950 dark:text-white">TechNova</span>
                    </div>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-xs mb-4">
                        Thiết bị công nghệ và phụ kiện chọn lọc. Cam kết chất lượng, bảo hành chuẩn mực và giao hàng toàn quốc.
                    </p>
                    <div class="flex items-center gap-2 text-zinc-400 text-sm">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span class="text-[11px] text-zinc-500">Hệ thống đang hoạt động</span>
                    </div>
                </div>

                <!-- Danh mục -->
                <div>
                    <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-4">Danh mục</h4>
                    <ul class="space-y-2.5 text-xs">
                        <li><a asp-controller="Products" asp-action="Index" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Tất cả sản phẩm</a></li>
                        <li><a asp-controller="Products" asp-action="Index" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Laptop & Thiết bị số</a></li>
                        <li><a asp-controller="Products" asp-action="Index" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Phụ kiện & Gaming</a></li>
                        <li><a asp-controller="Products" asp-action="Index" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Tài liệu công nghệ</a></li>
                    </ul>
                </div>

                <!-- Hỗ trợ & Chính sách -->
                <div>
                    <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-4">Chính sách</h4>
                    <ul class="space-y-2.5 text-xs">
                        <li><a asp-controller="Home" asp-action="Privacy" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Chính sách bảo mật</a></li>
                        <li><a href="#" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Chính sách giao nhận</a></li>
                        <li><a href="#" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Đổi trả & hoàn tiền</a></li>
                        <li><a href="#" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Điều khoản dịch vụ</a></li>
                    </ul>
                </div>

                <!-- Cam kết thanh toán -->
                <div>
                    <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-4">Giao dịch an toàn</h4>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed mb-3">
                        Thanh toán bảo mật qua COD hoặc cổng VNPay có mã hóa HMAC-SHA512.
                    </p>
                    <div class="flex items-center gap-3 text-lg text-zinc-400">
                        <i class="fab fa-cc-visa" title="Visa"></i>
                        <i class="fab fa-cc-mastercard" title="Mastercard"></i>
                        <i class="fas fa-hand-holding-usd" title="COD"></i>
                        <i class="fas fa-shield-alt" title="Bảo mật"></i>
                    </div>
                </div>
            </div>

            <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 dark:text-zinc-400">
                <p>&copy; @DateTime.UtcNow.Year TechNova. Bản demo portfolio cá nhân.</p>
                <p class="mt-2 sm:mt-0 text-[11px]">Xây dựng trên ASP.NET Core 10 &amp; Tailwind CSS.</p>
            </div>
        </div>
    </footer>

    @await Component.InvokeAsync("Notyf")
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Toggle Sáng/Tối + lưu lựa chọn.
        (function () {
            var btn = document.getElementById('theme-toggle');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var dark = document.documentElement.classList.toggle('dark');
                try { localStorage.setItem('technova-theme', dark ? 'dark' : 'light'); } catch (e) {}
            });
        })();
    </script>
</body>
</html>
