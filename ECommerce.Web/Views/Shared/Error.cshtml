@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    var statusEmoji = Model.StatusCode switch
    {
        404 => "fas fa-search-location",
        403 => "fas fa-user-lock",
        400 => "fas fa-exclamation-triangle",
        _ => "fas fa-bomb"
    };

    var badgeColor = Model.StatusCode switch
    {
        404 => "bg-blue-50 text-blue-700 border-blue-200",
        403 => "bg-amber-50 text-amber-700 border-amber-200",
        400 => "bg-orange-50 text-orange-700 border-orange-200",
        _ => "bg-rose-50 text-rose-700 border-rose-200"
    };
}

<div class="min-h-[70vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg w-full bg-white dark:bg-gray-900 rounded-3xl shadow-xl border border-gray-100 dark:border-gray-800 p-8 sm:p-10 text-center">
        <div class="w-20 h-20 bg-indigo-50 dark:bg-indigo-900/40 rounded-full flex items-center justify-center mx-auto mb-4 text-primary dark:text-indigo-300 text-3xl">
            <i class="@statusEmoji"></i>
        </div>

        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold border mb-3 @badgeColor">
            HTTP @Model.StatusCode
        </span>

        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">@Model.Title</h1>
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-6 leading-relaxed">
            @Model.Description
        </p>

        @if (!string.IsNullOrEmpty(Model.OriginalPath))
        {
            <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-3 text-xs text-gray-600 dark:text-gray-400 mb-6 text-left border border-gray-100 dark:border-gray-800">
                <span class="font-semibold text-gray-700 dark:text-gray-300">Đường dẫn yêu cầu:</span> <code class="text-primary dark:text-indigo-300 font-mono">@Model.OriginalPath</code>
            </div>
        }

        @if (Model.ShowRequestId)
        {
            <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-3 text-xs text-gray-500 dark:text-gray-400 mb-6 text-left border border-gray-100 dark:border-gray-800 font-mono">
                <span>Request ID:</span> <code>@Model.RequestId</code>
            </div>
        }

        <div class="flex flex-wrap justify-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center px-5 py-2.5 rounded-xl bg-primary hover:bg-indigo-700 text-white text-sm font-semibold transition-colors shadow-md">
                <i class="fas fa-home mr-2 text-xs"></i> Trang chủ
            </a>
            <a asp-controller="Products" asp-action="Index" class="inline-flex items-center px-5 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 text-gray-700 dark:text-gray-300 text-sm font-medium transition-colors">
                <i class="fas fa-shopping-bag mr-2 text-xs"></i> Sản phẩm
            </a>
            <a asp-controller="Cart" asp-action="Index" class="inline-flex items-center px-5 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 text-gray-700 dark:text-gray-300 text-sm font-medium transition-colors">
                <i class="fas fa-shopping-cart mr-2 text-xs"></i> Giỏ hàng
            </a>
        </div>
    </div>
</div>
