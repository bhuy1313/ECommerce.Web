@model ECommerce.Web.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ & địa chỉ";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <nav class="flex text-xs text-zinc-500 dark:text-zinc-400 mb-6 items-center gap-1.5" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Trang chủ</a>
        <span class="text-zinc-400 dark:text-zinc-600">/</span>
        <span class="text-zinc-900 dark:text-zinc-100 font-medium">Hồ sơ &amp; địa chỉ</span>
    </nav>

    <div class="mb-8">
        <h1 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">Hồ sơ &amp; địa chỉ</h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Quản lý sổ địa chỉ giao hàng để thanh toán nhanh hơn</p>
    </div>

    <section class="mb-8">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-3 flex items-center gap-2">
            <i class="fas fa-map-marked-alt text-zinc-500"></i>Địa chỉ đã lưu
        </h2>

        @if (Model.Addresses.Count == 0)
        {
            <div class="bg-white dark:bg-zinc-900 rounded-lg border border-dashed border-zinc-200 dark:border-zinc-800 p-8 text-center text-xs text-zinc-500 dark:text-zinc-400">
                <i class="fas fa-location-dot text-xl text-zinc-300 dark:text-zinc-600 mb-2 block"></i>
                Bạn chưa lưu địa chỉ nào.
            </div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var address in Model.Addresses)
                {
                    <div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 p-4 shadow-sm">
                        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                            <div>
                                <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
                                    @address.RecipientName
                                    @if (address.IsDefault)
                                    {
                                        <span class="text-[10px] font-medium uppercase tracking-wider bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 px-2 py-0.5 rounded border border-zinc-200 dark:border-zinc-700">Mặc định</span>
                                    }
                                </p>
                                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
                                    <i class="fas fa-phone text-[10px] mr-1 text-zinc-400"></i>@address.RecipientPhone
                                </p>
                                <p class="text-xs text-zinc-600 dark:text-zinc-300 mt-1">@address.AddressLine</p>
                            </div>

                            <div class="flex items-center gap-2 flex-shrink-0 pt-2 sm:pt-0">
                                @if (!address.IsDefault)
                                {
                                    <form asp-action="SetDefault" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@address.Id" />
                                        <button type="submit" class="text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 px-2.5 py-1 rounded border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-800 active:scale-[0.98] transition-all">
                                            Đặt mặc định
                                        </button>
                                    </form>
                                }
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Xóa địa chỉ này?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@address.Id" />
                                    <button type="submit" class="text-xs font-medium text-rose-600 dark:text-rose-400 hover:text-rose-700 px-2.5 py-1 rounded border border-rose-200 dark:border-rose-900/50 hover:bg-rose-50 dark:hover:bg-rose-950/20 active:scale-[0.98] transition-all">
                                        Xóa
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <partial name="_AddressForm" model="Model.NewAddress" />
</div>