@model ECommerce.Web.Models.ViewModels.AddressFormViewModel

<form asp-controller="Profile" asp-action="Add" method="post" class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 p-5 sm:p-6 shadow-sm">
    @Html.AntiForgeryToken()
    <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100 mb-4 flex items-center gap-2">
        <i class="fas fa-plus-circle text-zinc-500"></i>Thêm địa chỉ mới
    </h2>

    <div asp-validation-summary="ModelOnly" class="p-2.5 bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/40 text-rose-700 dark:text-rose-300 rounded-md text-xs mb-3" role="alert"></div>

    <div class="grid gap-3 sm:grid-cols-2">
        <div>
            <label asp-for="RecipientName" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
            <input asp-for="RecipientName" autocomplete="name" placeholder="Nguyễn Văn A"
                   class="w-full px-3 py-2 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" />
            <span asp-validation-for="RecipientName" class="block mt-1 text-xs text-rose-500"></span>
        </div>

        <div>
            <label asp-for="RecipientPhone" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
            <input asp-for="RecipientPhone" type="tel" autocomplete="tel" placeholder="09xx xxx xxx"
                   class="w-full px-3 py-2 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100" />
            <span asp-validation-for="RecipientPhone" class="block mt-1 text-xs text-rose-500"></span>
        </div>

        <div class="sm:col-span-2">
            <label asp-for="AddressLine" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1"></label>
            <textarea asp-for="AddressLine" rows="2" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành"
                      class="w-full px-3 py-2 text-sm border border-zinc-300 dark:border-zinc-700 rounded-md bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:focus:ring-zinc-100"></textarea>
            <span asp-validation-for="AddressLine" class="block mt-1 text-xs text-rose-500"></span>
        </div>
    </div>

    <label class="mt-3.5 inline-flex items-center gap-2 text-xs font-medium text-zinc-700 dark:text-zinc-300 cursor-pointer">
        <input asp-for="MakeDefault" class="h-4 w-4 rounded border-zinc-300 dark:border-zinc-700 text-zinc-900 accent-zinc-900 dark:accent-zinc-100 cursor-pointer" />
        @Html.DisplayNameFor(m => m.MakeDefault)
    </label>

    <div class="mt-4">
        <button type="submit" class="bg-zinc-900 hover:bg-zinc-800 dark:bg-zinc-100 dark:hover:bg-white text-white dark:text-zinc-950 text-xs font-medium py-2 px-4 rounded-md active:scale-[0.98] transition-all">
            Lưu địa chỉ
        </button>
    </div>
</form>